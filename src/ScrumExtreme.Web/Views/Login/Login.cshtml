@{
    ViewData["Title"] = "Logga in";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-wrapper">
    <div class="login-logo-wrap">
        <img src="~/images/ottoshattshop2.png" class="login-logo" alt="Hattmakaren AB" />
    </div>
    <div class="login-card">

        <div class="login-brand">
            <span class="login-brand-dot"></span>
            <h2 class="login-title">Logga in</h2>
        </div>

        <div class="login-divider"></div>

        <form method="post" asp-controller="Login" asp-action="Index" class="login-form">
            <div class="login-field">
                <label for="username">Användarnamn</label>
                <input type="text" id="username" name="username" placeholder="Ditt användarnamn" required
                       autocomplete="username">
            </div>
            <div class="login-field">
                <label for="password">Lösenord</label>
                <input type="password" id="password" name="password" placeholder="Ditt lösenord" required
                       autocomplete="current-password">
            </div>
            <label class="login-show-password">
                <input type="checkbox" id="showPassword">
                <span class="login-checkbox-box"></span>
                <span class="login-checkbox-label">Visa lösenord</span>
            </label>
            <button type="submit" class="login-btn" id="loginBtn">Logga in</button>
        </form>

        <p class="login-footer">Inget konto? Placera dig i kö hos SysAdmin.</p>

    </div>

    <div class="login-quickfill">
        <button type="button" class="login-quickfill-btn"
                onclick="quickFill('abdimalik.content','abdi123')">Anställd</button>
        <button type="button" class="login-quickfill-btn" onclick="quickFill('otto.ottosson','otto123')">Admin</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
    <script>
        document.getElementById('showPassword').addEventListener('change', function () {
            document.getElementById('password').type = this.checked ? 'text' : 'password';
        });

        function quickFill(user, pass) {
            document.getElementById('username').value = user;
            document.getElementById('password').value = pass;
            var cb = document.getElementById('showPassword');
            if (cb.checked) {
                cb.checked = false;
                document.getElementById('password').type = 'password';
            }
        }
    </script>
}
