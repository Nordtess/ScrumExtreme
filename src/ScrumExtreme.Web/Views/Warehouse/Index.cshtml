@model ScrumExtreme.Web.Models.WarehouseViewModel
@using System.Linq
@{
    ViewData["Title"] = "Lagerstatus";
    var hatList = Model?.Hats?.ToList() ?? new List<ScrumExtreme.Domain.Entities.Hats>();
    var materialList = Model?.Materials?.ToList() ?? new List<ScrumExtreme.Domain.Entities.Material>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/warehouse.css" asp-append-version="true" />
}

<div class="warehouse-wrapper">

    <div class="admin-page-header">
        <h1 class="admin-page-title">Lagerstatus</h1>
        <p class="admin-page-subtitle">Se och ändra lagersaldo för hattar, material och tillbehör</p>
    </div>

    <!-- ── Filter bar ── -->
    <div class="warehouse-filter-bar">
        <label class="warehouse-filter-label" for="sectionFilter">Visa</label>
        <select id="sectionFilter" class="warehouse-filter-select">
            <option value="all">Visa alla</option>
            <option value="hats">Hattar</option>
            <option value="material">Material</option>
            <option value="tillbehor">Tillbehör</option>
        </select>
    </div>

    <!-- ════════════════════ HATTAR ════════════════════ -->
    <section class="warehouse-section" data-section="hats">
        <div class="warehouse-section-header">
            <h2 class="warehouse-section-title">Hattar</h2>
            <span class="warehouse-section-count">@hatList.Count st</span>
        </div>

        @if (!hatList.Any())
        {
            <p class="warehouse-empty">Inga hattar hittades i systemet.</p>
        }
        else
        {
            <div class="warehouse-grid">
                @foreach (var hat in hatList)
                {
                    var savedTotal = hat.Stock.Values.Sum();
                    <div class="warehouse-card" data-saved-total="@savedTotal">
                        <div class="warehouse-card-header">
                            <h2 class="warehouse-card-name">@hat.Name</h2>
                            <span class="warehouse-card-price">@hat.Price kr</span>
                        </div>
                        <div class="warehouse-card-body">
                            @if (!string.IsNullOrWhiteSpace(hat.MaterialList))
                            {
                                <p class="warehouse-card-meta">@hat.MaterialList</p>
                            }
                            <div class="warehouse-stock-grid">
                                @foreach (var size in hat.Sizes)
                                {
                                    var qty = hat.Stock.TryGetValue(size, out var q) ? q : 0;
                                    <div class="warehouse-size-block">
                                        <span class="warehouse-size-label">@size</span>
                                        <input class="warehouse-size-input @(qty <= 0 ? "--low" : "")" type="number" min="0"
                                               step="1" inputmode="numeric" pattern="[0-9]*" data-size="@size" value="@qty" />
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="warehouse-card-footer">
                            <button class="warehouse-save-btn" data-hat-id="@hat.Id">Spara</button>
                            <span class="warehouse-status"></span>
                            @if (!string.IsNullOrWhiteSpace(hat.MaterialList))
                            {
                                <span class="warehouse-material-hint" data-material="@hat.MaterialList"
                                      style="display:none;"></span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- ── Divider ── -->
    <div class="warehouse-divider" data-section-divider="material"></div>

    <!-- ════════════════════ MATERIAL ════════════════════ -->
    <section class="warehouse-section" data-section="material">
        <div class="warehouse-section-header">
            <h2 class="warehouse-section-title">Material</h2>
            <span class="warehouse-section-count" id="material-count">@materialList.Count st</span>
        </div>
        <p class="warehouse-section-note">Lagersaldo för råmaterial.</p>

        <div class="warehouse-add-row">
            <input id="new-material-name" type="text" placeholder="Namn" class="warehouse-text-input" maxlength="100" />
            <input id="new-material-stock" type="number" min="0" step="1" placeholder="Antal" class="warehouse-simple-input"
                   inputmode="numeric" pattern="[0-9]*" />
            <input id="new-material-price" type="number" min="0" step="1" placeholder="Pris/st"
                   class="warehouse-simple-input" inputmode="numeric" pattern="[0-9]*" />
            <button id="add-material-btn" class="warehouse-save-btn --small">Lägg till</button>
            <span id="add-material-status" class="warehouse-status"></span>
        </div>

        <div class="warehouse-list" id="material-list">
            <div class="warehouse-list-header">
                <span>Namn</span>
                <span>Antal</span>
                <span>Pris/st</span>
                <span>I lager (kr)</span>
                <span></span>
            </div>
            @foreach (var mat in materialList)
            {
                <div class="warehouse-list-row" data-material-id="@mat.Id">
                    <span class="warehouse-list-name">@mat.Name</span>
                    <input class="warehouse-simple-input warehouse-qty-input" type="number" min="0" step="1"
                           inputmode="numeric" pattern="[0-9]*" value="@mat.Stock" aria-label="Antal @mat.Name" />
                    <input class="warehouse-price-input" type="number" min="0" step="1" inputmode="numeric" pattern="[0-9]*"
                           value="@((int)mat.Price)" aria-label="Pris @mat.Name" />
                    <span class="warehouse-list-total">@((mat.Stock * (int)mat.Price).ToString()) kr</span>
                    <button class="warehouse-delete-material-btn" data-material-id="@mat.Id" title="Ta bort @mat.Name">✕</button>
                </div>
            }
            <div class="warehouse-list-footer">
                <span class="warehouse-footer-label">Totalt lagervärde:</span>
                <span class="warehouse-footer-total" id="material-grand-total">0 kr</span>
                <button class="warehouse-save-btn --small" id="material-save-btn">Spara alla</button>
                <span class="warehouse-status" id="material-status"></span>
            </div>
        </div>
    </section>

    <!-- ── Divider ── -->
    <div class="warehouse-divider" data-section-divider="tillbehor"></div>

    <!-- ════════════════════ TILLBEHÖR ════════════════════ -->
    <section class="warehouse-section" data-section="tillbehor">
        <div class="warehouse-section-header">
            <h2 class="warehouse-section-title">Tillbehör</h2>
            <span class="warehouse-section-count" id="tillbehor-count">@(Model?.Items?.Count() ?? 0) st</span>
        </div>
        <p class="warehouse-section-note">Lagersaldo för dekorativa tillbehör.</p>

        <div class="warehouse-add-row">
            <input id="new-item-name" type="text" placeholder="Namn" class="warehouse-text-input" maxlength="100" />
            <input id="new-item-stock" type="number" min="0" step="1" placeholder="Antal" class="warehouse-simple-input"
                   inputmode="numeric" pattern="[0-9]*" />
            <input id="new-item-price" type="number" min="0" step="1" placeholder="Pris/st"
                   class="warehouse-simple-input" inputmode="numeric" pattern="[0-9]*" />
            <button id="add-item-btn" class="warehouse-save-btn --small">Lägg till</button>
            <span id="add-item-status" class="warehouse-status"></span>
        </div>

        <div class="warehouse-list" id="tillbehor-list">
            <div class="warehouse-list-header">
                <span>Namn</span>
                <span>Antal</span>
                <span>Pris/st (kr)</span>
                <span>I lager (kr)</span>
                <span></span>
            </div>
            @foreach (var item in Model?.Items ?? Enumerable.Empty<ScrumExtreme.Domain.Entities.Item>())
            {
                <div class="warehouse-list-row" data-item-id="@item.Id">
                    <span class="warehouse-list-name">@item.Name</span>
                    <input class="warehouse-simple-input warehouse-qty-input" type="number" min="0" step="1"
                           inputmode="numeric" pattern="[0-9]*" value="@item.Stock" aria-label="Antal @item.Name" />
                    <input class="warehouse-price-input" type="number" min="0" step="1" inputmode="numeric" pattern="[0-9]*"
                           value="@((int)item.Price)" aria-label="Pris @item.Name" />
                    <span class="warehouse-list-total">@((item.Stock * (int)item.Price).ToString()) kr</span>
                    <button class="warehouse-delete-btn" data-item-id="@item.Id" title="Ta bort @item.Name">✕</button>
                </div>
            }
            <div class="warehouse-list-footer">
                <span class="warehouse-footer-label">Totalt lagervärde:</span>
                <span class="warehouse-footer-total" id="tillbehor-grand-total">0 kr</span>
                <button class="warehouse-save-btn --small" id="tillbehor-save-btn">Spara alla</button>
                <span class="warehouse-status" id="tillbehor-status"></span>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script>
        // ── Section filter ──────────────────────────────────────────────────
        const onlyLetters = /^[a-zA-ZåäöÅÄÖéèêëàâùûüîïôœæçÉÈÊËÀÂÙÛÜÎÏÔŒÆÇ\s\-]+$/;

        function toTitleCase(str) {
            return str.toLowerCase().replace(/(?:^|\s|-)\S/g, c => c.toUpperCase());
        }

        const filterSelect = document.getElementById('sectionFilter');
        const sections = document.querySelectorAll('.warehouse-section');
        const dividers = document.querySelectorAll('.warehouse-divider');

        filterSelect.addEventListener('change', applyFilter);

        function applyFilter() {
            const val = filterSelect.value;
            sections.forEach(s => {
                s.style.display = (val === 'all' || s.dataset.section === val) ? '' : 'none';
            });
            // Show divider only when both surrounding sections are visible
            dividers.forEach(d => {
                const key = d.dataset.sectionDivider; // e.g. "material"
                const keys = ['hats', 'material', 'tillbehor'];
                const idx = keys.indexOf(key);
                const prev = document.querySelector(`.warehouse-section[data-section="${keys[idx - 1]}"]`);
                const next = document.querySelector(`.warehouse-section[data-section="${key}"]`);
                const bothVisible = prev && next &&
                    prev.style.display !== 'none' && next.style.display !== 'none';
                d.style.display = bothVisible ? '' : 'none';
            });
        }

        // ── Input sanitisation (hat stock inputs) ──────────────────────────
        function sanitiseInput(input) {
            let raw = input.value.replace(/[^0-9]/g, '');
            raw = raw === '' ? '' : String(parseInt(raw, 10));
            input.value = raw;
        }

        document.querySelectorAll('.warehouse-size-input').forEach(input => {
            input.addEventListener('input', () => {
                sanitiseInput(input);
                updateMaterialHint(input.closest('.warehouse-card'));
            });
            input.addEventListener('keydown', e => {
                const allow = ['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight', 'Home', 'End'];
                if (!allow.includes(e.key) && !/^[0-9]$/.test(e.key)) e.preventDefault();
            });
            input.addEventListener('blur', () => {
                if (input.value === '') {
                    input.value = '0';
                    updateMaterialHint(input.closest('.warehouse-card'));
                }
            });
        });

        // ── Same sanitisation for material / tillbehör inputs ──────────────
        document.querySelectorAll('.warehouse-simple-input').forEach(input => {
            input.addEventListener('input', () => sanitiseInput(input));
            input.addEventListener('keydown', e => {
                const allow = ['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight', 'Home', 'End'];
                if (!allow.includes(e.key) && !/^[0-9]$/.test(e.key)) e.preventDefault();
            });
            input.addEventListener('blur', () => {
                if (input.value === '') input.value = '0';
            });
        });

        // ── Material usage hint (only shows when NEW total > saved total) ──
        function updateMaterialHint(card) {
            const hintEl = card.querySelector('.warehouse-material-hint');
            if (!hintEl) return;
            const material = hintEl.dataset.material;
            const savedTotal = parseInt(card.dataset.savedTotal || '0', 10);
            const inputs = card.querySelectorAll('.warehouse-size-input');
            let currentTotal = 0;
            inputs.forEach(inp => {
                const v = parseInt(inp.value, 10);
                if (!isNaN(v)) currentTotal += v;
            });
            const added = currentTotal - savedTotal;
            if (added > 0) {
                hintEl.textContent = `Beräknad materialåtgång: ${added} ${material}`;
                hintEl.style.display = '';
            } else {
                hintEl.style.display = 'none';
            }
        }

        // ── Live totals for material / tillbehör lists ─────────────────────
        function updateListTotals(list) {
            let grand = 0;
            list.querySelectorAll('.warehouse-list-row').forEach(row => {
                const qty = parseInt(row.querySelector('.warehouse-qty-input').value, 10) || 0;
                const price = parseInt(row.querySelector('.warehouse-price-input').value, 10) || 0;
                const total = qty * price;
                grand += total;
                row.querySelector('.warehouse-list-total').textContent = total.toLocaleString('sv-SE') + ' kr';
            });
            list.querySelector('.warehouse-footer-total').textContent = grand.toLocaleString('sv-SE') + ' kr';
        }

        document.querySelectorAll('.warehouse-list').forEach(list => {
            list.querySelectorAll('.warehouse-qty-input, .warehouse-price-input').forEach(input => {
                input.addEventListener('input', () => {
                    sanitiseInput(input);
                    updateListTotals(list);
                });
                input.addEventListener('keydown', e => {
                    const allow = ['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight', 'Home', 'End'];
                    if (!allow.includes(e.key) && !/^[0-9]$/.test(e.key)) e.preventDefault();
                });
                input.addEventListener('blur', () => {
                    if (input.value === '') { input.value = '0'; updateListTotals(list); }
                });
            });
            // Calculate totals from server-rendered values on page load
            updateListTotals(list);
        });

        // ── Save hat stock ──────────────────────────────────────────────────
        document.querySelectorAll('.warehouse-save-btn:not([disabled])').forEach(btn => {
            btn.addEventListener('click', async () => {
                const card = btn.closest('.warehouse-card');
                const hatId = btn.dataset.hatId;
                const statusEl = card.querySelector('.warehouse-status');

                statusEl.textContent = '';
                statusEl.className = 'warehouse-status';

                const inputs = card.querySelectorAll('.warehouse-size-input');
                const stockMap = {};

                for (const input of inputs) {
                    const size = input.dataset.size;
                    const quantity = parseInt(input.value, 10);
                    if (isNaN(quantity) || quantity < 0) {
                        statusEl.textContent = 'Ogiltigt antal för ' + size;
                        statusEl.className = 'warehouse-status --error';
                        return;
                    }
                    stockMap[size] = quantity;
                }

                btn.disabled = true;
                btn.textContent = 'Sparar…';

                try {
                    const result = await fetch('/Warehouse/SaveHatStock', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ hatId, stock: stockMap })
                    });

                    if (!result.ok) {
                        let msg = 'Fel vid sparning.';
                        try {
                            const body = await result.json();
                            if (body && body.error) msg = body.error;
                        } catch { /* ignore */ }
                        statusEl.textContent = msg;
                        statusEl.className = 'warehouse-status --error';
                        return;
                    }

                    const data = await result.json();

                    // Update material rows in DOM if stock was deducted
                    if (data.materialStocks) {
                        for (const [matId, newStock] of Object.entries(data.materialStocks)) {
                            const row = document.querySelector(`#material-list .warehouse-list-row[data-material-id="${matId}"]`);
                            if (!row) continue;
                            const qtyInput = row.querySelector('.warehouse-qty-input');
                            const priceInput = row.querySelector('.warehouse-price-input');
                            const totalEl = row.querySelector('.warehouse-list-total');
                            if (qtyInput) qtyInput.value = newStock;
                            if (totalEl && priceInput) {
                                const price = parseInt(priceInput.value, 10) || 0;
                                totalEl.textContent = (newStock * price) + ' kr';
                            }
                        }
                        // Recalculate material grand total
                        updateListTotals(document.getElementById('material-list'));
                    }

                    // Update saved total so the hint resets correctly
                    const newTotal = Object.values(stockMap).reduce((a, b) => a + b, 0);
                    card.dataset.savedTotal = newTotal;

                    inputs.forEach(input => {
                        const val = parseInt(input.value, 10);
                        input.classList.toggle('--low', val <= 0);
                    });

                    // Hide hint after save
                    const hintEl = card.querySelector('.warehouse-material-hint');
                    if (hintEl) hintEl.style.display = 'none';

                    statusEl.textContent = 'Sparat ✓';
                    statusEl.className = 'warehouse-status';
                    setTimeout(() => { statusEl.textContent = ''; }, 2500);
                } catch {
                    statusEl.textContent = 'Fel vid sparning.';
                    statusEl.className = 'warehouse-status --error';
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Spara';
                }
            });
        });

        // ── Tillbehör: save all ─────────────────────────────────────────────
        const tillbehorSaveBtn = document.getElementById('tillbehor-save-btn');
        const tillbehorStatus = document.getElementById('tillbehor-status');
        if (tillbehorSaveBtn) {
            tillbehorSaveBtn.addEventListener('click', async () => {
                const rows = document.querySelectorAll('#tillbehor-list .warehouse-list-row[data-item-id]');
                if (!rows.length) return;
                tillbehorSaveBtn.disabled = true;
                tillbehorSaveBtn.textContent = 'Sparar…';
                tillbehorStatus.textContent = '';
                tillbehorStatus.className = 'warehouse-status';
                let errors = 0;
                for (const row of rows) {
                    const itemId = row.dataset.itemId;
                    const stock = parseInt(row.querySelector('.warehouse-qty-input').value, 10) || 0;
                    const price = parseInt(row.querySelector('.warehouse-price-input').value, 10) || 0;
                    try {
                        const res = await fetch('/Warehouse/UpdateItem', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ itemId, stock, price })
                        });
                        if (!res.ok) errors++;
                    } catch { errors++; }
                }
                tillbehorSaveBtn.disabled = false;
                tillbehorSaveBtn.textContent = 'Spara alla';
                if (errors) {
                    tillbehorStatus.textContent = `${errors} rad(er) misslyckades.`;
                    tillbehorStatus.className = 'warehouse-status --error';
                } else {
                    tillbehorStatus.textContent = 'Sparat ✓';
                    tillbehorStatus.className = 'warehouse-status';
                    setTimeout(() => { tillbehorStatus.textContent = ''; }, 2500);
                }
            });
        }

        // ── Tillbehör: delete ───────────────────────────────────────────────
        function wireDeleteBtn(btn) {
            btn.addEventListener('click', async () => {
                const itemId = btn.dataset.itemId;
                if (!confirm('Ta bort tillbehöret?')) return;
                try {
                    const res = await fetch(`/Warehouse/DeleteItem/${itemId}`, { method: 'DELETE' });
                    if (res.ok) {
                        btn.closest('.warehouse-list-row').remove();
                        const count = document.querySelectorAll('#tillbehor-list .warehouse-list-row').length;
                        const countEl = document.getElementById('tillbehor-count');
                        if (countEl) countEl.textContent = count + ' st';
                        updateListTotals(document.getElementById('tillbehor-list'));
                    } else {
                        alert('Kunde inte ta bort tillbehöret.');
                    }
                } catch {
                    alert('Nätverksfel vid borttagning.');
                }
            });
        }
        document.querySelectorAll('.warehouse-delete-btn').forEach(wireDeleteBtn);

        // ── Tillbehör: add new ──────────────────────────────────────────────
        const addItemBtn = document.getElementById('add-item-btn');
        const addItemStatus = document.getElementById('add-item-status');
        if (addItemBtn) {
            addItemBtn.addEventListener('click', async () => {
                const nameInput = document.getElementById('new-item-name');
                const stockInput = document.getElementById('new-item-stock');
                const priceInput = document.getElementById('new-item-price');
                const name = nameInput.value.trim();
                const stock = parseInt(stockInput.value, 10) || 0;
                const price = parseInt(priceInput.value, 10) || 0;

                if (!name) {
                    addItemStatus.textContent = 'Namn krävs.';
                    addItemStatus.className = 'warehouse-status --error';
                    return;
                }
                if (!onlyLetters.test(name)) {
                    addItemStatus.textContent = 'Namnet får bara innehålla bokstäver.';
                    addItemStatus.className = 'warehouse-status --error';
                    return;
                }
                if (price <= 0) {
                    addItemStatus.textContent = 'Pris m\u00e5ste vara st\u00f6rre \u00e4n 0.';
                    addItemStatus.className = 'warehouse-status --error';
                    return;
                }
                addItemBtn.disabled = true;
                addItemStatus.textContent = '';
                addItemStatus.className = 'warehouse-status';

                try {
                    const res = await fetch('/Warehouse/CreateItem', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name, stock, price })
                    });
                    const data = await res.json();
                    if (!res.ok) {
                        addItemStatus.textContent = data.error ?? 'Fel vid skapande.';
                        addItemStatus.className = 'warehouse-status --error';
                    } else {
                        const list = document.getElementById('tillbehor-list');
                        const footer = list.querySelector('.warehouse-list-footer');
                        const newRow = document.createElement('div');
                        newRow.className = 'warehouse-list-row';
                        newRow.dataset.itemId = data.id;
                        newRow.innerHTML = `
                                    <span class="warehouse-list-name">${data.name}</span>
                                    <input class="warehouse-simple-input warehouse-qty-input" type="number" min="0" step="1"
                                           inputmode="numeric" pattern="[0-9]*" value="${stock}" aria-label="Antal ${data.name}" />
                                    <input class="warehouse-price-input" type="number" min="0" step="1"
                                           inputmode="numeric" pattern="[0-9]*" value="${price}" aria-label="Pris ${data.name}" />
                                    <span class="warehouse-list-total">${stock * price} kr</span>
                                    <button class="warehouse-delete-btn" data-item-id="${data.id}" title="Ta bort ${data.name}">✕</button>`;
                        list.insertBefore(newRow, footer);

                        wireDeleteBtn(newRow.querySelector('.warehouse-delete-btn'));
                        newRow.querySelectorAll('.warehouse-qty-input, .warehouse-price-input').forEach(inp => {
                            inp.addEventListener('input', () => { sanitiseInput(inp); updateListTotals(list); });
                            inp.addEventListener('blur', () => { if (inp.value === '') { inp.value = '0'; updateListTotals(list); } });
                        });

                        const cnt = document.querySelectorAll('#tillbehor-list .warehouse-list-row').length;
                        const countEl = document.getElementById('tillbehor-count');
                        if (countEl) countEl.textContent = cnt + ' st';
                        updateListTotals(list);

                        nameInput.value = '';
                        stockInput.value = '';
                        priceInput.value = '';
                        addItemStatus.textContent = data.name + ' tillagd ✓';
                        addItemStatus.className = 'warehouse-status';
                        setTimeout(() => { addItemStatus.textContent = ''; }, 2500);
                    }
                } catch {
                    addItemStatus.textContent = 'Nätverksfel.';
                    addItemStatus.className = 'warehouse-status --error';
                } finally {
                    addItemBtn.disabled = false;
                }
            });
        }

        // ── Material: delete ────────────────────────────────────────────────
        function wireDeleteMaterialBtn(btn) {
            btn.addEventListener('click', async () => {
                const materialId = btn.dataset.materialId;
                if (!confirm('Ta bort materialet?')) return;
                try {
                    const res = await fetch(`/Warehouse/DeleteMaterial/${materialId}`, { method: 'DELETE' });
                    if (res.ok) {
                        btn.closest('.warehouse-list-row').remove();
                        const count = document.querySelectorAll('#material-list .warehouse-list-row').length;
                        const countEl = document.getElementById('material-count');
                        if (countEl) countEl.textContent = count + ' st';
                        updateListTotals(document.getElementById('material-list'));
                    } else {
                        alert('Kunde inte ta bort materialet.');
                    }
                } catch {
                    alert('Nätverksfel vid borttagning.');
                }
            });
        }
        document.querySelectorAll('.warehouse-delete-material-btn').forEach(wireDeleteMaterialBtn);

        // ── Material: save all ──────────────────────────────────────────────
        const materialSaveBtn = document.getElementById('material-save-btn');
        const materialStatus = document.getElementById('material-status');
        if (materialSaveBtn) {
            materialSaveBtn.addEventListener('click', async () => {
                const rows = document.querySelectorAll('#material-list .warehouse-list-row[data-material-id]');
                if (!rows.length) return;
                materialSaveBtn.disabled = true;
                materialSaveBtn.textContent = 'Sparar…';
                materialStatus.textContent = '';
                materialStatus.className = 'warehouse-status';
                let errors = 0;
                for (const row of rows) {
                    const materialId = row.dataset.materialId;
                    const stock = parseInt(row.querySelector('.warehouse-qty-input').value, 10) || 0;
                    const price = parseInt(row.querySelector('.warehouse-price-input').value, 10) || 0;
                    try {
                        const res = await fetch('/Warehouse/UpdateMaterial', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ materialId, stock, price })
                        });
                        if (!res.ok) errors++;
                    } catch { errors++; }
                }
                materialSaveBtn.disabled = false;
                materialSaveBtn.textContent = 'Spara alla';
                if (errors) {
                    materialStatus.textContent = `${errors} rad(er) misslyckades.`;
                    materialStatus.className = 'warehouse-status --error';
                } else {
                    materialStatus.textContent = 'Sparat ✓';
                    materialStatus.className = 'warehouse-status';
                    setTimeout(() => { materialStatus.textContent = ''; }, 2500);
                }
            });
        }

        // ── Material: add new ───────────────────────────────────────────────
        const addMaterialBtn = document.getElementById('add-material-btn');
        const addMaterialStatus = document.getElementById('add-material-status');
        if (addMaterialBtn) {
            addMaterialBtn.addEventListener('click', async () => {
                const nameInput = document.getElementById('new-material-name');
                const stockInput = document.getElementById('new-material-stock');
                const priceInput = document.getElementById('new-material-price');
                const name = nameInput.value.trim();
                const stock = parseInt(stockInput.value, 10) || 0;
                const price = parseInt(priceInput.value, 10) || 0;

                if (!name) {
                    addMaterialStatus.textContent = 'Namn krävs.';
                    addMaterialStatus.className = 'warehouse-status --error';
                    return;
                }
                if (!onlyLetters.test(name)) {
                    addMaterialStatus.textContent = 'Namnet får bara innehålla bokstäver.';
                    addMaterialStatus.className = 'warehouse-status --error';
                    return;
                }
                if (price <= 0) {
                    addMaterialStatus.textContent = 'Pris måste vara större än 0.';
                    addMaterialStatus.className = 'warehouse-status --error';
                    return;
                }
                addMaterialBtn.disabled = true;
                addMaterialStatus.textContent = '';
                addMaterialStatus.className = 'warehouse-status';

                try {
                    const res = await fetch('/Warehouse/CreateMaterial', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name, stock, price })
                    });
                    const data = await res.json();
                    if (!res.ok) {
                        addMaterialStatus.textContent = data.error ?? 'Fel vid skapande.';
                        addMaterialStatus.className = 'warehouse-status --error';
                    } else {
                        const list = document.getElementById('material-list');
                        const footer = list.querySelector('.warehouse-list-footer');
                        const newRow = document.createElement('div');
                        newRow.className = 'warehouse-list-row';
                        newRow.dataset.materialId = data.id;
                        newRow.innerHTML = `
                            <span class="warehouse-list-name">${data.name}</span>
                            <input class="warehouse-simple-input warehouse-qty-input" type="number" min="0" step="1"
                                   inputmode="numeric" pattern="[0-9]*" value="${stock}" aria-label="Antal ${data.name}" />
                            <input class="warehouse-price-input" type="number" min="0" step="1"
                                   inputmode="numeric" pattern="[0-9]*" value="${price}" aria-label="Pris ${data.name}" />
                            <span class="warehouse-list-total">${stock * price} kr</span>
                            <button class="warehouse-delete-material-btn" data-material-id="${data.id}" title="Ta bort ${data.name}">✕</button>`;
                        list.insertBefore(newRow, footer);

                        wireDeleteMaterialBtn(newRow.querySelector('.warehouse-delete-material-btn'));
                        newRow.querySelectorAll('.warehouse-qty-input, .warehouse-price-input').forEach(inp => {
                            inp.addEventListener('input', () => { sanitiseInput(inp); updateListTotals(list); });
                            inp.addEventListener('blur', () => { if (inp.value === '') { inp.value = '0'; updateListTotals(list); } });
                        });

                        const cnt = document.querySelectorAll('#material-list .warehouse-list-row').length;
                        const countEl = document.getElementById('material-count');
                        if (countEl) countEl.textContent = cnt + ' st';
                        updateListTotals(list);

                        nameInput.value = '';
                        stockInput.value = '';
                        priceInput.value = '';
                        addMaterialStatus.textContent = data.name + ' tillagd ✓';
                        addMaterialStatus.className = 'warehouse-status';
                        setTimeout(() => { addMaterialStatus.textContent = ''; }, 2500);
                    }
                } catch {
                    addMaterialStatus.textContent = 'Nätverksfel.';
                    addMaterialStatus.className = 'warehouse-status --error';
                } finally {
                    addMaterialBtn.disabled = false;
                }
            });
        }
    </script>
}
