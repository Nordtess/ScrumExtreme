@{
    ViewData["Title"] = "Home Page";
}

<div class="hero">
    <img src="~/images/hattar.png" alt="Two exclusive hats in a dark picture">
        <h1 class="display-4">Hattmakaren</h1>
    </div>

    <div class="body-text">
        <h2>Välkommen till oss på Hattmakaren AB!</h2>
        <p>Vi tillverkar och säljer egengjorda hattar men vi utför även custom orders</p>
    </div>

    <div class="selection">
        <h2>Urval av våra produkter</h2>
        <p>Här kan du se några av våra mest populära produkter.</p>
        <div class="bigplayer">
            <h2>Big Player</h2>
            <img src="~/images/hat1.png" alt="En vit hatt med fjädrar och en blå ädelsten">
                <p>Hatten Big Player, en exklusiv hatt med fjädrar och en blå ädelsten. Denna hatt visar alla att du är en
                    person att räkna med</p>
                </div>
                <div class="steampunk">
                    <h2>Steampunker</h2>
                    <img src="~/images/hat2.png" alt="En steampunk-inspirerad hatt med kugghjul och glasögon">
                        <p>Hatten Steampunker, en unik hatt med kugghjul och glasögon. Denna hatt är perfekt för dig som älskar
                            steampunk-stilen.</p>
                        </div>
                        <div class="CamoDude">
                            <h2>Camo Dude</h2>
                            <img src="~/images/hat3.png" alt="En camo-inspirerad hatt med militärmönster">
                                <p>Hatten Camo Dude, en unik hatt med militärmönster. Denna hatt är perfekt för dig som älskar camo-stilen.</p>
                            </div>
                            <div class="themalik">
                                <h2>The Malik</h2>
                                <img src="~/images/hat4.png" alt="En unik hatt i pirattema">
                                    <p>Hatten The Malik, hatten för den som älskar pirater och det äventyrliga livet.</p>
                                </div>

                            </div>
