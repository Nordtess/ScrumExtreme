@model IEnumerable<ScrumExtreme.Domain.Entities.Order>

@using ScrumExtreme.Domain.Entities
@{
    ViewData["Title"] = "Home";
    var userLookup = ViewBag.UserLookup as Dictionary<string, ScrumExtreme.Domain.Entities.User>
                     ?? new Dictionary<string, ScrumExtreme.Domain.Entities.User>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mainpage.css" asp-append-version="true" />
}

<div class="admin-wrapper">

    <div class="admin-page-header">
        <h1 class="admin-page-title">Översikt</h1>
        <p class="admin-page-subtitle">Dagens produktionsstatus på ett ögonblick</p>
    </div>

    <div class="home-grid">

        <!-- ── Left: Calendar ── -->
        <div class="home-col">
            <p class="home-calendar-title">FREDRIKS FINA KALENDER</p>
            <div class="home-calendar-card">
                <img src="~/images/fredriksfinakalender.png" alt="Fredriks Fina Kalender" class="home-calendar-img" />
            </div>
        </div>

        <!-- ── Right: Order summary ── -->
        <div class="home-col">

            <!-- Filter bar -->
            <div class="order-filter-bar" style="margin-bottom:0.75rem;">
                <div class="order-filter-group">
                    <label class="order-filter-label" for="homeOrderSort">Sortera</label>
                    <select id="homeOrderSort" class="order-filter-select">
                        <option value="newest" selected>Senast skapad</option>
                        <option value="oldest">Tidigast skapad</option>
                    </select>
                </div>
                <div class="order-filter-group">
                    <span class="order-filter-label">Typ</span>
                    <div class="order-type-pills">
                        <button class="order-type-pill active" data-type="standard">Standard</button>
                        <button class="order-type-pill active" data-type="modifierad">Modifierad</button>
                        <button class="order-type-pill active" data-type="special">Special</button>
                    </div>
                </div>
                <div class="order-filter-group">
                    <label class="order-filter-label" for="homeOrderStatus">Status</label>
                    <select id="homeOrderStatus" class="order-filter-select">
                        <option value="all" selected>Visa alla</option>
                        <option value="pending">Väntar</option>
                        <option value="processing">Påbörjad</option>
                        <option value="printed">Utskriven</option>
                        <option value="shipped">Skickad</option>
                        <option value="delivered">Levererad</option>
                        <option value="cancelled">Avbruten</option>
                    </select>
                </div>
            </div>

            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h2 class="admin-panel-title">
                        <span class="admin-panel-dot"></span>Orderöversikt
                        @if (Model != null)
                        {
                            <span class="admin-customer-count">@Model.Count()</span>
                        }
                    </h2>
                    <a asp-controller="Orders" asp-action="Create" class="admin-panel-btn">Skapa ny order →</a>
                </div>
                <div class="admin-panel-body home-orders-body">
                    <div class="admin-customer-list" id="homeOrderList">
                        @if (Model == null || !Model.Any())
                        {
                            <span class="admin-list-placeholder">Inga ordrar hittades.</span>
                        }
                        else
                        {
                            foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                            {
                                string orderTypClass;
                                string orderTypLabel;
                                if (order.Items != null && order.Items.Any(i => i.SpecialHats != null))
                                {
                                    orderTypClass = "order-type-badge order-type-special";
                                    orderTypLabel = "Special";
                                }
                                else if (order.Items != null && order.Items.Any(i => i.IsModified))
                                {
                                    orderTypClass = "order-type-badge order-type-modified";
                                    orderTypLabel = "Modifierad";
                                }
                                else
                                {
                                    orderTypClass = "order-type-badge order-type-standard";
                                    orderTypLabel = "Standard";
                                }
                                var hasUser = userLookup.TryGetValue(order.UserId, out var u);
                                string fullName = hasUser ? $"{u!.FirstName} {u!.LastName}" : "–";
                                string statusKey = order.Status.ToString().ToLower();
                                string statusLabel = order.Status switch
                                {
                                    OrderStatus.Pending => "Väntar",
                                    OrderStatus.Processing => "Påbörjad",
                                    OrderStatus.Printed => "Utskriven",
                                    OrderStatus.Shipped => "Skickad",
                                    OrderStatus.Delivered => "Levererad",
                                    OrderStatus.Cancelled => "Avbruten",
                                    _ => order.Status.ToString()
                                };
                                string typeKey = orderTypLabel.ToLower();
                                <div class="admin-customer-row home-order-row"
                                     data-date="@order.OrderDate.ToUniversalTime().Ticks" data-type="@typeKey"
                                     data-status="@statusKey">
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                                       class="admin-customer-name">@order.OrderNumber</a>
                                    <span class="@orderTypClass">@orderTypLabel</span>
                                    <span class="order-col-name">@fullName</span>
                                    <span class="order-status-badge order-status-@statusKey">@statusLabel</span>
                                    <span class="home-order-date">@order.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                    <span class="home-order-total">@order.TotalAmount.ToString("0.00") kr</span>
                                    <button class="order-delete-btn" data-id="@order.Id" title="Ta bort order">✕</button>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            var sortSelect = document.getElementById('homeOrderSort');
            var statusSelect = document.getElementById('homeOrderStatus');
            var list = document.getElementById('homeOrderList');
            if (!sortSelect || !statusSelect || !list) return;

            document.querySelectorAll('.order-type-pill').forEach(function (pill) {
                pill.addEventListener('click', function () {
                    this.classList.toggle('active');
                    applyFilters();
                });
            });

            function applyFilters() {
                var rows = Array.from(list.querySelectorAll('.home-order-row'));
                var activePills = new Set(
                    Array.from(document.querySelectorAll('.order-type-pill.active')).map(function (p) { return p.dataset.type; })
                );
                var statusVal = statusSelect.value;
                var newest = sortSelect.value === 'newest';

                rows.sort(function (a, b) {
                    var da = BigInt(a.dataset.date);
                    var db = BigInt(b.dataset.date);
                    return newest ? (db > da ? 1 : db < da ? -1 : 0)
                        : (da > db ? 1 : da < db ? -1 : 0);
                });
                rows.forEach(function (r) { list.appendChild(r); });

                rows.forEach(function (row) {
                    var typeMatch = activePills.has(row.dataset.type);
                    var statusMatch = statusVal === 'all' || row.dataset.status === statusVal;
                    row.style.display = (typeMatch && statusMatch) ? '' : 'none';
                });
            }

            sortSelect.addEventListener('change', applyFilters);
            statusSelect.addEventListener('change', applyFilters);

            list.querySelectorAll('.order-delete-btn').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var id = this.dataset.id;
                    if (!confirm('Är du säker på att du vill ta bort denna order?')) return;
                    var res = await fetch('/Orders/Delete/' + id, { method: 'POST' });
                    if (res.ok) {
                        this.closest('.home-order-row').remove();
                        var countEl = document.querySelector('.admin-customer-count');
                        if (countEl) countEl.textContent = parseInt(countEl.textContent) - 1;
                    } else {
                        alert('Något gick fel. Försök igen.');
                    }
                });
            });
        })();
    </script>
}
