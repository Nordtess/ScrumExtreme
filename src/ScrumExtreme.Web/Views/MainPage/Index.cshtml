@{
    ViewData["Title"] = "Huvudsida Test";
}

@section Styles {
    <link rel="stylesheet" href="~/css/mainpage.css" asp-append-version="true" />
}

<div class="mp-dashboard">

    <!-- Page Header -->
    <div class="mp-page-header">
        <h1 class="mp-page-title">Produktionsöversikt</h1>
        <p class="mp-page-subtitle">Realtidsöversikt för produktion, försäljning och lagerstatus</p>
    </div>

    <!-- KPI Row -->
    <div class="mp-kpi-row">
        <div class="mp-kpi-card --neutral">
            <div class="mp-kpi-icon">📋</div>
            <div class="mp-kpi-value">24</div>
            <div class="mp-kpi-label">Aktiva ordrar</div>
        </div>
        <div class="mp-kpi-card --alert">
            <div class="mp-kpi-icon">⚠</div>
            <div class="mp-kpi-value">3</div>
            <div class="mp-kpi-label">Försenade ordrar</div>
        </div>
        <div class="mp-kpi-card --good">
            <div class="mp-kpi-icon">kr</div>
            <div class="mp-kpi-value">18 450</div>
            <div class="mp-kpi-label">Dagens försäljning (kr)</div>
        </div>
        <div class="mp-kpi-card --warn">
            <div class="mp-kpi-icon">⊘</div>
            <div class="mp-kpi-value">5</div>
            <div class="mp-kpi-label">Lågt lagersaldo</div>
        </div>
    </div>

    <!-- 3-Panel Grid -->
    <div class="mp-panels">

        <!-- Left: Sales -->
        <div class="mp-panel">
            <div class="mp-panel-header">
                <h2 class="mp-panel-title">
                    <span class="mp-panel-dot"></span>Försäljning
                </h2>
                <a asp-controller="SalesStatistics" asp-action="Index" class="mp-panel-btn">Visa statistik →</a>
            </div>
            <div class="mp-panel-body">
                <div class="mp-stat-grid">
                    <div class="mp-stat-row">
                        <span class="mp-stat-label">Idag</span>
                        <span class="mp-stat-value">18 450 kr</span>
                    </div>
                    <div class="mp-stat-row">
                        <span class="mp-stat-label">Denna vecka</span>
                        <span class="mp-stat-value">97 200 kr</span>
                    </div>
                    <div class="mp-stat-row">
                        <span class="mp-stat-label">Denna månad</span>
                        <span class="mp-stat-value">412 800 kr</span>
                    </div>
                    <div class="mp-stat-row">
                        <span class="mp-stat-label">Ordrar idag</span>
                        <span class="mp-stat-value">6</span>
                    </div>
                </div>

                <div class="mp-best-seller">
                    <span class="mp-best-seller-label">Bästsäljare denna vecka</span>
                    <span class="mp-best-seller-value">Fedora Classic</span>
                </div>

                <div class="mp-chart-section">
                    <div class="mp-chart-label">Försäljning per dag (v. 15)</div>
                    <div class="mp-chart">
                        <div class="mp-bar" style="--h:55%"><span>Mån</span></div>
                        <div class="mp-bar" style="--h:72%"><span>Tis</span></div>
                        <div class="mp-bar" style="--h:40%"><span>Ons</span></div>
                        <div class="mp-bar" style="--h:88%"><span>Tor</span></div>
                        <div class="mp-bar" style="--h:63%"><span>Fre</span></div>
                        <div class="mp-bar --today" style="--h:45%"><span>Lör</span></div>
                        <div class="mp-bar" style="--h:0%"><span>Sön</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Center: Orders -->
        <div class="mp-panel --center">
            <div class="mp-panel-header">
                <h2 class="mp-panel-title">
                    <span class="mp-panel-dot"></span>Orderöversikt
                </h2>
                <a asp-controller="Orders" asp-action="Index" class="mp-panel-btn">Visa alla ordrar →</a>
            </div>
            <div class="mp-panel-body">

                <div class="mp-orders-toolbar">
                    <select id="orderSort" class="mp-orders-sort">
                        <option value="newest">Senast skapad</option>
                        <option value="oldest">Tidigast skapad</option>
                        <option value="status">Status (prioritet)</option>
                    </select>
                    <label class="mp-filter-check">
                        <input type="checkbox" id="filterUnassigned" />
                        Ej tilldelade
                    </label>
                </div>

                <div class="mp-orders-scroll">
                    <table class="mp-orders-table">
