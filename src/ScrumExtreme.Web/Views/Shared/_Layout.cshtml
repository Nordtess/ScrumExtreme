<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ScrumExtreme.Web</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Playwrite+IE:wght@100..400&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet">
    
    <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700&family=Noto+Sans+SC&family=Noto+Sans+JP&family=Noto+Sans+KR&family=Noto+Sans+Arabic&family=Noto+Sans+Devanagari&display=block"
    rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header class="site-header">
        @{
            var userRole = Context.Session.GetString("UserRole");
            var isLoginPage = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "")
                              .Equals("Login", StringComparison.OrdinalIgnoreCase);
            var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        }
@if (!isLoginPage && !string.IsNullOrEmpty(userRole))

        {
            <nav class="navbar">
                <button class="nav-hamburger" id="navHamburger" aria-label="Öppna meny" aria-expanded="false">
                    <span class="ham-bar"></span>
                    <span class="ham-bar"></span>
                    <span class="ham-bar"></span>
                </button>
                <div class="navbar-links-wrapper" id="navLinksWrapper">
                    <ul class="navbar-links">
                        @if (userRole == "employee" || userRole == "admin")
                        {
                            <li><a asp-area="" asp-controller="MainPage" asp-action="Index"
                                       class="@(ctrl == "MainPage" && act == "Index" ? "active" : "")">Home</a></li>
                                <li><a asp-area="" asp-controller="AddCustomer" asp-action="Index"
                                           class="@(ctrl == "AddCustomer" && act == "Index" ? "active" : "")">Lägg till Kund</a></li>
                                    <li><a asp-area="" asp-controller="AddCustomer" asp-action="AllCustomers"
                                               class="@(ctrl == "AddCustomer" && act == "AllCustomers" ? "active" : "")">Alla Kunder</a>
                                    </li>
                                    <li><a asp-area="" asp-controller="CreateHats" asp-action="Index"
                                               class="@(ctrl == "CreateHats" && act == "Index" ? "active" : "")">Lägg till Hatt</a></li>
                                        <li><a asp-area="" asp-controller="MaterialSummary" asp-action="PrintMaterialSummary"
                                                   class="@(ctrl == "MaterialSummary" ? "active" : "")">Materialstatus</a></li>
                                            <li><a asp-area="" asp-controller="Orders" asp-action="Create"
                                                       class="@(ctrl == "Orders" && act == "Create" ? "active" : "")">Skapa Order</a></li>
                                                <li><a asp-area="" asp-controller="Orders" asp-action="Index"
                                                           class="@(ctrl == "Orders" && act == "Index" ? "active" : "")">Alla Ordrar</a></li>
                                                    <li><a asp-area="" asp-controller="Warehouse" asp-action="Index"
                                                               class="@(ctrl == "Warehouse" && act == "Index" ? "active" : "")">Lagerstatus</a></li>
                                                    <li><a asp-area="" asp-controller="Statistics" asp-action="Index"
                                                               class="@(ctrl == "Statistics" ? "active" : "")">Statistik</a></li>
                                                        @if (userRole == "admin")
                                                        {
                                                            <li><a asp-area="" asp-controller="AddEmployee" asp-action="Index"
                                                                       class="@(ctrl == "AddEmployee" && act == "Index" ? "active" : "")">Lägg till Anställd</a>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            </div>
                                            <ul class="navbar-right">
                                                <li><a asp-area="" asp-controller="Login" asp-action="Logout">Logga ut</a></li>
                                            </ul>
                                        </nav>
                                    }
                                </header>

                                <main class="site-main">
                                    @RenderBody()
                                </main>

                                <footer class="site-footer">
                                    <p>&copy; 2026 - ScrumExtreme</p>
                                </footer>
                                <script src="~/js/site.js" asp-append-version="true"></script>
                                <script>
                                        (function () {
                                            var btn = document.getElementById('navHamburger');
                                            var wrapper = document.getElementById('navLinksWrapper');
                                            if (!btn || !wrapper) return;
                                            // Restore persisted open state
                                            if (localStorage.getItem('navOpen') === '1') {
                                                btn.classList.add('open');
                                                wrapper.classList.add('open');
                                                btn.setAttribute('aria-expanded', 'true');
                                            }
                                            btn.addEventListener('click', function () {
                                                var isOpen = btn.classList.toggle('open');
                                                wrapper.classList.toggle('open', isOpen);
                                                btn.setAttribute('aria-expanded', isOpen);
                                                localStorage.setItem('navOpen', isOpen ? '1' : '0');
                                            });
                                        })();
                                </script>
                                @await RenderSectionAsync("Scripts", required: false)
                            </body>

                        </html>
