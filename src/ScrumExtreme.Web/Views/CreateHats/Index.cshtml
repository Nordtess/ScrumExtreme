@model ScrumExtreme.Web.Models.CreateHatsViewModel
@{
    ViewData["Title"] = "Hatthantering";
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
}

<div class="admin-wrapper --narrow">

    @if (TempData["Success"] != null)
    {
        <p class="admin-toast">@TempData["Success"]</p>
    }

    <div class="admin-page-header">
        <h1 class="admin-page-title">Hatthantering</h1>
        <p class="admin-page-subtitle">Lägg till och hantera hattar i systemet</p>
    </div>

    <div class="admin-layout --single">

        <!-- Create hat form -->
        <div class="admin-panel">
            <div class="admin-panel-header">
                <h2 class="admin-panel-title">
                    <span class="admin-panel-dot"></span>Lägg till ny hatt
                </h2>
            </div>
            <div class="admin-panel-body">
                <form asp-action="CreateHats" method="post" class="admin-form" id="createHatForm">

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label asp-for="Name">Namn</label>
                            <input asp-for="Name" id="Name" placeholder="T.ex. Fedora" />
                            <span class="admin-error" id="error-Name"></span>
                        </div>
                    </div>

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label>Tillgängliga storlekar</label>
                            <div class="size-checkbox-group" id="sizesGroup">
                                @foreach (var size in new[] { "XS", "S", "M", "L", "XL", "XXL", "One Size" })
                                {
                                    var isChecked = Model.Sizes != null && Model.Sizes.Contains(size);
                                    <label class="size-checkbox-label">
                                        <input type="checkbox" name="Sizes" value="@size" @(isChecked ? "checked" : "") />
                                        @size
                                    </label>
                                }
                            </div>
                            <span class="admin-error" id="error-Sizes"></span>
                        </div>
                    </div>

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label asp-for="Price">Pris (SEK)</label>
                            <input asp-for="Price" id="Price" type="number" step="0.01" min="1" />
                            <span class="admin-error" id="error-Price"></span>
                        </div>
                    </div>

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label>Material</label>
                            @if (Model.AvailableMaterials != null && Model.AvailableMaterials.Any())
                            {
                                <div class="size-checkbox-group" id="materialsGroup">
                                    @foreach (var mat in Model.AvailableMaterials)
                                    {
                                        var isChecked = Model.SelectedMaterials != null && Model.SelectedMaterials.Contains(mat);
                                        <label class="size-checkbox-label">
                                            <input type="checkbox" name="SelectedMaterials" value="@mat" @(isChecked ? "checked" : "") />
                                            @mat
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="admin-field-hint">Inga material tillagda ännu. Lägg till material i Lagerstatus.</p>
                            }
                            <span class="admin-error" id="error-Materials"></span>
                        </div>
                    </div>


                    <div class="admin-submit-area">
                        <button type="submit" class="admin-btn-primary" id="hatSubmitBtn">Skapa hatt</button>
                        <span class="admin-submit-error" id="hatSubmitError"></span>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/createhats.js" asp-append-version="true"></script>
}
