@model ScrumExtreme.Web.Models.CreateHatsViewModel
@{
    ViewData["Title"] = "Hatthantering";
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
}

<div class="admin-wrapper">

    @if (TempData["Success"] != null)
    {
        <p class="admin-toast">@TempData["Success"]</p>
    }

    <div class="admin-page-header">
        <h1 class="admin-page-title">Hatthantering</h1>
        <p class="admin-page-subtitle">Lägg till och hantera hattar i systemet</p>
    </div>

    <div class="admin-layout">

        <!-- Left: Add hat form -->
        <div class="admin-panel">
            <div class="admin-panel-header">
                <h2 class="admin-panel-title">
                    <span class="admin-panel-dot"></span>Lägg till ny hatt
                </h2>
            </div>
            <div class="admin-panel-body">
                <form asp-action="CreateHats" method="post" class="admin-form">

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label asp-for="Name">Namn</label>
                            <input asp-for="Name" placeholder="T.ex. Fedora" />
                        </div>
                    </div>

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label asp-for="Size">Storlek</label>
                            <input asp-for="Size" placeholder="T.ex. S, M, L, XL" />
                        </div>
                    </div>

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label asp-for="Price">Pris (SEK)</label>
                            <input asp-for="Price" type="number" step="0.01" min="0" />
                        </div>
                    </div>

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label asp-for="MaterialList">Materiallista</label>
                            <input asp-for="MaterialList" placeholder="T.ex. Ull, Bomull" />
                        </div>
                    </div>

                    <div class="admin-submit-area">
                        <button type="submit" class="admin-btn-primary">
                            Skapa hatt
                        </button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Right: Hat list -->
        <div class="admin-panel">
            <div class="admin-panel-header">
                <h2 class="admin-panel-title">
                    <span class="admin-panel-dot"></span>Alla hattar
                </h2>

                <form asp-action="ShowHats" method="post" class="admin-panel-fetch-form">
                    <button type="submit" class="admin-panel-btn">
                        Hämta →
                    </button>
                </form>
            </div>

            <div class="admin-panel-body">
                <div class="admin-customer-list">
                    @{
                        var hats = ViewBag.Hats as IEnumerable<ScrumExtreme.Domain.Entities.Hats>;
                    }

                    @if (hats == null)
                    {
                        <span class="admin-list-placeholder">
                            Tryck på "Hämta" för att visa listan.
                        </span>
                    }
                    else
                    {
                        var list = hats.ToList();

                        if (list.Count == 0)
                        {
                            <span class="admin-list-placeholder">
                                Inga hattar hittades.
                            </span>
                        }
                        else
                        {
                            foreach (var hat in list)
                            {
                                <div class="admin-customer-row">
                                    <span>@hat.Name</span>
                                    <span>@hat.Size</span>
                                    <span>@hat.Price kr</span>
                                </div>
                            }
                        }
                    }

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
