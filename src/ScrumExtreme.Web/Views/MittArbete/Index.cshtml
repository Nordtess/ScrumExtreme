@model ScrumExtreme.Web.Models.MittArbeteViewModel
@{
    ViewData["Title"] = "Mitt Arbete";
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lagerhantering.css" asp-append-version="true" />
}

<div class="admin-wrapper">

    <div class="admin-page-header">
        <h1 class="admin-page-title">Mitt Arbete</h1>
        <p class="admin-page-subtitle">@Model.WorkerName — dina tilldelade ordrar och kommande händelser</p>
    </div>

    <div class="lager-hub-grid">

        <!-- Mina ordrar – stats -->
        <div class="lager-hub-card">
            <div class="lager-hub-card__header">
                <h2 class="lager-hub-card__title">
                    <span class="lager-hub-card__dot"></span>
                    Mina ordrar
                </h2>
            </div>
            <div class="lager-hub-card__body">
                <div class="lager-hub-stats">
                    <div class="lager-hub-stat">
                        <span class="lager-hub-stat__label">Aktiva ordrar</span>
                        <span class="lager-hub-stat__value">@Model.ActiveOrders</span>
                        <span class="lager-hub-stat__sub">tilldelade till mig</span>
                    </div>
                    <div class="lager-hub-stat">
                        <span class="lager-hub-stat__label">Slutförda ordrar</span>
                        <span class="lager-hub-stat__value">@Model.CompletedOrders</span>
                        <span class="lager-hub-stat__sub">skickade</span>
                    </div>
                </div>
                <div class="lager-hub-divider"></div>
                <p style="font-size:0.78rem;color:#555;margin:0;">
                    Här visas ordrar som är tilldelade dig och som ännu inte skickats. Klicka på en order för att se
                    detaljer.
                </p>
            </div>
            <div class="lager-hub-card__footer">
                <a asp-controller="Orders" asp-action="Index" class="lager-hub-btn">
                    Alla ordrar
                </a>
            </div>
        </div>

        <!-- Mitt schema -->
        <div class="lager-hub-card">
            <div class="lager-hub-card__header">
                <h2 class="lager-hub-card__title">
                    <span class="lager-hub-card__dot"></span>
                    Mitt schema
                </h2>
            </div>
            <div class="lager-hub-card__body">
                <div class="lager-hub-stats">
                    <div class="lager-hub-stat">
                        <span class="lager-hub-stat__label">Kommande händelser</span>
                        <span class="lager-hub-stat__value">@Model.UpcomingEvents</span>
                        <span class="lager-hub-stat__sub">från och med idag</span>
                    </div>
                </div>
                <div class="lager-hub-divider"></div>
                @if (!Model.MyEvents.Any())
                {
                    <p style="font-size:0.78rem;color:#888;margin:0;">Inga kommande händelser inbokade.</p>
                }
                else
                {
                    <div style="display:flex;flex-direction:column;gap:0.45rem;">
                        @foreach (var ev in Model.MyEvents.Take(4))
                        {
                            <div style="display:flex;align-items:center;gap:0.6rem;">
                                <span class="lager-hub-status-pill" style="background:@ev.TypeColor;">@ev.TypeLabel</span>
                                <span style="font-size:0.77rem;color:#555;">
                                    @ev.Start.ToLocalTime().ToString("d MMM", new System.Globalization.CultureInfo("sv-SE"))
                                    –
                                    @ev.End.ToLocalTime().ToString("d MMM yyyy", new System.Globalization.CultureInfo("sv-SE"))
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="lager-hub-card__footer">
                <a asp-controller="MainPage" asp-action="Index" class="lager-hub-btn">
                    Öppna kalender
                </a>
            </div>
        </div>

    </div>

    <!-- Mina aktiva ordrar – tabell -->
    <div class="lager-hub-card" style="grid-column: 1 / -1;">
        <div class="lager-hub-card__header">
            <h2 class="lager-hub-card__title">
                <span class="lager-hub-card__dot"></span>
                Mina aktiva ordrar
            </h2>
        </div>
        <div class="lager-hub-card__body" style="padding:0;">
            @if (!Model.MyOrders.Any())
            {
                <p style="padding:1.3rem;font-size:0.8rem;color:#888;">Inga aktiva ordrar tilldelade dig just nu.</p>
            }
            else
            {
                <div class="lager-hub-recent-list">
                    <div class="lager-hub-recent-header" style="grid-template-columns: 1.2fr 1.5fr 1fr 1fr 1fr;">
                        <span>Order</span>
                        <span>Kund</span>
                        <span>Datum</span>
                        <span>Belopp</span>
                        <span>Status</span>
                    </div>
                    @foreach (var row in Model.MyOrders)
                    {
                        <a href="/Orders/Details/@row.OrderId" class="lager-hub-recent-row"
                               style="grid-template-columns: 1.2fr 1.5fr 1fr 1fr 1fr;">
                            <span class="lager-hub-recent-mono">@row.OrderNumber</span>
                            <span>@row.CustomerName</span>
                            <span style="color:#888;">@row.OrderDate.ToString("yyyy-MM-dd")</span>
                            <span>@row.TotalAmount.ToString("N0") kr</span>
                            <span>
                                <span class="lager-hub-status-pill" style="background:@row.StatusColor;">
                                    @row.StatusLabel
                                </span>
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>

</div>
