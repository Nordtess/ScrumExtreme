@model ScrumExtreme.Web.Models.MaterialSummaryPageViewModel

@{
	ViewData["Title"] = "Materialöversikt";
}

@section Styles {
	<link rel="stylesheet" href="~/css/materialsummary.css" asp-append-version="true" />
}

<div class="admin-wrapper">

	@if (TempData["Success"] != null)
	{
		<p class="admin-toast">@TempData["Success"]</p>
	}

	<div class="admin-page-header">
		<h1 class="admin-page-title">Materialöversikt</h1>
		<p class="admin-page-subtitle">
			Översikt av material och tillbehör som krävs för ordrar som väntar på utskrift
		</p>
	</div>

	<div class="admin-layout">

		<div class="admin-panel-stack">

			
			<div class="admin-panel">

				<div class="admin-panel-header">
					<h2 class="admin-panel-title">
						<span class="admin-panel-dot"></span>
						Material i behov

						@if (Model?.Materials != null)
						{
							<span class="admin-customer-count">@Model.Materials.Count</span>
						}
					</h2>
				</div>

				<div class="admin-panel-body">

					@if (Model?.Materials == null || !Model.Materials.Any())
					{
						<span class="admin-list-placeholder">
							Inga material hittades för väntande ordrar.
						</span>
					}
					else
					{
						<div class="admin-customer-list">

							<div class="material-summary-header">
								<span>Material</span>
								<span>Antal</span>
								<span>Pris per styck</span>
								<span>Totalt pris</span>
							</div>

							@foreach (var mat in Model.Materials)
							{
								<div class="admin-customer-row">
									<span class="admin-customer-name">@mat.MaterialName</span>
									<span class="admin-customer-count material-col-qty">@mat.TotalQuantity</span>
									<span class="material-col-price">@mat.PricePerUnit.ToString("0.00") kr</span>
									<span class="material-col-total">@mat.TotalPrice.ToString("0.00") kr</span>
								</div>
							}

						</div>
					}

				</div>
			</div>

			
			<div class="admin-panel">

				<div class="admin-panel-header">
					<h2 class="admin-panel-title">
						<span class="admin-panel-dot"></span>
						Tillbehör i behov

						@if (Model?.Items != null)
						{
							<span class="admin-customer-count">@Model.Items.Count</span>
						}
					</h2>
				</div>

				<div class="admin-panel-body">

					@if (Model?.Items == null || !Model.Items.Any())
					{
						<span class="admin-list-placeholder">
							Inga tillbehör hittades för väntande ordrar.
						</span>
					}
					else
					{
						<div class="admin-customer-list">

							<div class="material-summary-header">
								<span>Tillbehör</span>
								<span>Antal</span>
								<span>Pris per styck</span>
								<span>Totalt pris</span>
							</div>

							@foreach (var item in Model.Items)
							{
								<div class="admin-customer-row">
									<span class="admin-customer-name">@item.ItemName</span>
									<span class="admin-customer-count material-col-qty">@item.TotalQuantity</span>
									<span class="material-col-price">@item.PricePerUnit.ToString("0.00") kr</span>
									<span class="material-col-total">@item.TotalPrice.ToString("0.00") kr</span>
								</div>
							}

						</div>
					}

				</div>
			</div>

		</div>

		
		<div class="admin-panel">

			<div class="admin-panel-header">
				<h2 class="admin-panel-title">
					<span class="admin-panel-dot"></span>
					Beställning
				</h2>
			</div>

			<div class="admin-panel-body">

				<p class="admin-field-hint">
					Skriv ut en materialbeställning för att sammanställa allt material och tillbehör
					som behöver beställas.
				</p>

				<a href="@Url.Action("PrintOrder", "MaterialSummary")" class="ms-print-btn">
					Skriv ut materialbeställning
				</a>

				@{
					var totalOrderCost = (Model?.Materials?.Sum(m => m.TotalPrice) ?? 0m)
									   + (Model?.Items?.Sum(i => i.TotalPrice) ?? 0m);
					var capitalAfter = (Model?.CapitalSEK ?? 0m) - totalOrderCost;
				}

				<div class="ms-capital-strip">
					<div class="ms-capital-row">
						<span class="ms-capital-label">Beställningens kostnad</span>
						<span class="ms-capital-value">@totalOrderCost.ToString("0.00") kr</span>
					</div>
					<div class="ms-capital-row">
						<span class="ms-capital-label">Nuvarande kapital</span>
						<span class="ms-capital-value">@(Model?.CapitalSEK.ToString("0.00") ?? "0.00") kr</span>
					</div>
					<div class="ms-capital-divider"></div>
					<div class="ms-capital-row ms-capital-row--total">
						<span class="ms-capital-label">Kapital efter beställning</span>
						<span class="ms-capital-value ms-capital-value--after">@capitalAfter.ToString("0.00") kr</span>
					</div>
				</div>

			</div>

		</div>

	</div>
</div>
