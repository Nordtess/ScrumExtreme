@model ScrumExtreme.Web.Models.OrderDetailsViewModel

@{
    ViewData["Title"] = "Orderdetaljer - " + Model.Order.OrderNumber;
    string statusLabel = Model.Order.Status switch
    {
        ScrumExtreme.Domain.Entities.OrderStatus.Pending => "Väntar",
        ScrumExtreme.Domain.Entities.OrderStatus.Processing => "Påbörjad",
        ScrumExtreme.Domain.Entities.OrderStatus.Printed => "Utskriven",
        ScrumExtreme.Domain.Entities.OrderStatus.Shipped => "Skickad",
        _ => Model.Order.Status.ToString()
    };
    string statusKey = Model.Order.Status.ToString().ToLower();
    string userRole = ViewBag.UserRole as string ?? "";
    bool canStart = Model.Order.Status == ScrumExtreme.Domain.Entities.OrderStatus.Pending
                    && (userRole == "employee" || userRole == "admin");
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />
}

<div class="admin-wrapper">
    <div class="admin-page-header">
        <h1 class="admin-page-title">Order @Model.Order.OrderNumber</h1>
        <p class="admin-page-subtitle">Placerad: @Model.Order.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm") | Status: <span class="order-status-badge order-status-@statusKey">@statusLabel</span></p>
    </div>

    <div class="admin-panel" style="margin-bottom: 20px;">
        <div class="admin-panel-header">
            <h2 class="admin-panel-title">Kund- och leveransuppgifter</h2>
        </div>

        <div class="admin-panel-body" style="padding: 20px;">
            <p><strong>Namn:</strong> @Model.Order.ShippingAddress.FullName</p>
            <p><strong>E-post:</strong> @Model.CustomerEmail</p>
            <p><strong>Telefon:</strong> @Model.Order.ShippingAddress.Phone</p>
            <hr style="margin: 15px 0; border: 0; border-top: 1px solid #eee;" />
            <p><strong>Adress:</strong></p>
            <p>
                @Model.Order.ShippingAddress.Address<br />
                @Model.Order.ShippingAddress.PostalCode @Model.Order.ShippingAddress.City<br />
                @Model.Order.ShippingAddress.Country (@Model.Order.ShippingAddress.CountryCode)
            </p>
        </div>
    </div>

    <div class="admin-panel">
        <div class="admin-panel-header">
            <h2 class="admin-panel-title">Beställda artiklar</h2>
        </div>

        <div class="admin-panel-body">
            <table style="width: 100%; text-align: left; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #eee;">
                        <th style="padding: 10px;">Artikel</th>
                        <th style="padding: 10px;">Storlek</th>
                        <th style="padding: 10px;">Antal</th>
                        <th style="padding: 10px;">A-pris</th>
                        <th style="padding: 10px;">Totalt</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Order.Items)
                    {
                        <tr style="border-bottom: 1px solid #eee;">
                            <td style="padding: 10px;">
                                @item.Name
                                @if (item.SpecialHats != null && !string.IsNullOrEmpty(item.SpecialHats.Description))
                                {
                                    <br />
                                    <span style="font-size: 0.85rem; color: #666;">
                                        <strong>Beskrivning:</strong> @item.SpecialHats.Description
                                    </span>
                                }
                                @if (item.IsModified && !string.IsNullOrEmpty(item.ModificationDescription))
                                {
                                    <br />
                                    <span style="font-size: 0.85rem; color: #666;">
                                        <strong>Modifiering:</strong> @item.ModificationDescription
                                    </span>
                                }
                                @if (item.IsModified && item.ItemIds != null && item.ItemIds.Any())
                                {
                                    <br />
                                    <span style="font-size: 0.85rem; color: #666;">
                                        <strong>Tillagt material:</strong>
                                        @{
                                            // Leta upp namnen för alla ID:n i listan
                                            var materialNames = item.ItemIds
                                            .Select(id => Model.MaterialNames.ContainsKey(id) ? Model.MaterialNames[id] : "Okänt material");
                                        }
                                        @string.Join(", ", materialNames)
                                    </span>
                                }
                            </td>
                            <td style="padding: 10px;">@(string.IsNullOrEmpty(item.Size) ? "–" : item.Size)</td>
                            <td style="padding: 10px;">@item.Quantity</td>
                            <td style="padding: 10px;">@item.UnitPrice.ToString("0.00") kr</td>
                            <td style="padding: 10px;">@( (item.Quantity * item.UnitPrice).ToString("0.00") ) kr</td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <td colspan="4" style="padding: 15px 10px; text-align: right; font-weight: bold;">Totalsumma:</td>
                        <td style="padding: 15px 10px; font-weight: bold; color: #c9a84c;">@Model.Order.TotalAmount.ToString("0.00") kr</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="order-details-actions" style="margin-top: 20px;">
        <a asp-action="Index" class="admin-panel-btn" style="text-decoration: none;">← Tillbaka till orderlistan</a>
        <button onclick="window.print()" class="admin-panel-btn" style="margin-left: 10px;">🖨️ Skriv ut order</button>
        <a href="/ShippingLabel?orderId=@Model.Order.Id" class="admin-panel-btn" style="margin-left: 10px; text-decoration: none;">🚚 Skriv ut fraktsedel</a>
        <button id="deleteOrderBtn" class="admin-panel-btn" style="margin-left: 10px;">🗑️ Radera order</button>
        @if (canStart)
        {
            <button id="startOrderBtn" class="admin-btn-primary admin-btn-auto" style="margin-left: 10px;">▶ Starta order</button>
        }
        @if (!string.IsNullOrEmpty(Model.AssignedWorkerName))
        {
            <span class="order-assigned-worker">Hanteras av: <strong>@Model.AssignedWorkerName</strong></span>
        }
    </div>

    @if (canStart)
    {
        <div id="startOrderOverlay" class="start-order-overlay" style="display:none;">
            <div class="start-order-modal">
                <h3 class="start-order-modal-title">Starta order @Model.Order.OrderNumber</h3>
                <p class="start-order-modal-subtitle">Ange beräknat slutdatum för ordern.</p>
                <div class="calendar-form-row">
                    <label class="calendar-form-label">Beräknat slutdatum</label>
                    <input id="estimatedEnd" type="datetime-local" class="calendar-form-input" />
                </div>
                <div class="start-order-modal-actions">
                    <button id="confirmStartBtn" class="admin-btn-primary admin-btn-auto">Bekräfta</button>
                    <button id="cancelStartBtn" class="admin-panel-btn">Avbryt</button>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('deleteOrderBtn').addEventListener('click', async function () {
            if (!confirm('Är du säker på att du vill radera order @Model.Order.OrderNumber? Detta kan inte ångras.')) return;
            var res = await fetch('/Orders/Delete/@Model.Order.Id', { method: 'POST' });
            if (res.ok) {
                window.location.href = '@Url.Action("Index", "Orders")';
            } else {
                alert('Något gick fel. Försök igen.');
            }
        });

        @if (canStart)
        {
            <text>
        const startBtn = document.getElementById('startOrderBtn');
        const overlay = document.getElementById('startOrderOverlay');
        const confirmBtn = document.getElementById('confirmStartBtn');
        const cancelBtn = document.getElementById('cancelStartBtn');

        startBtn.addEventListener('click', function () {
            overlay.style.display = 'flex';
        });
        cancelBtn.addEventListener('click', function () {
            overlay.style.display = 'none';
        });
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) overlay.style.display = 'none';
        });

        confirmBtn.addEventListener('click', async function () {
            const endVal = document.getElementById('estimatedEnd').value;
            if (!endVal) {
                alert('Välj ett beräknat slutdatum.');
                return;
            }
            const res = await fetch('/Orders/StartOrder/@Model.Order.Id', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ estimatedEnd: endVal })
            });
            if (res.ok) {
                window.location.reload();
            } else {
                const err = await res.json().catch(() => ({}));
                alert(err.error ?? 'Något gick fel. Försök igen.');
            }
        });
            </text>
        }
    </script>
}