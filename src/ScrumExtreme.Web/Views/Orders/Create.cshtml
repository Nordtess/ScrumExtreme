@model ScrumExtreme.Web.Models.CreateOrderViewModel
@using ScrumExtreme.Domain.Entities

@{
    ViewData["Title"] = "Skapa Order";
    var customers = ViewBag.Customers as IEnumerable<User>;
    var products = ViewBag.Products as IEnumerable<Product>;
    var projectName = ViewBag.ProjectName as string ?? "ScrumExtreme";
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />
}

<div class="admin-wrapper">
    <div class="project-info">
        <p>🚀 Projekt: <strong>@projectName</strong></p>
    </div>

    @if (TempData["Success"] != null)
    {
        <p class="admin-toast">@TempData["Success"]</p>
    }

    <div class="admin-page-header">
        <h1 class="admin-page-title">Skapa Order</h1>
        <p class="admin-page-subtitle">Skapa en ny order i systemet</p>
    </div>

    <div class="admin-layout">

        <!-- Left: Create order -->
        <div class="admin-panel">
            <div class="admin-panel-header">
                <h2 class="admin-panel-title">
                    <span class="admin-panel-dot"></span>Lägg till ny order
                </h2>
            </div>

            <div class="admin-panel-body">
                <form asp-action="Create" method="post" class="admin-form" id="createOrderForm">

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label asp-for="CustomerId">Kund</label>
                            <select asp-for="CustomerId" class="admin-input">
                                <option value="">Välj kund</option>
                                @if (customers != null)
                                {
                                    foreach (var customer in customers)
                                    {
                                        <option value="@customer.Id">@customer.FirstName @customer.LastName</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="admin-error"></span>
                        </div>
                    </div>

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label asp-for="ProductId">Produkt</label>
                            <select asp-for="ProductId" class="admin-input">
                                <option value="">Välj produkt</option>
                                @if (products != null)
                                {
                                    foreach (var product in products)
                                    {
                                        <option value="@product.Id">@product.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ProductId" class="admin-error"></span>
                        </div>
                    </div>

                    <div class="admin-submit-area">
                        <button type="submit" class="admin-btn-primary" id="submitBtn">Spara order</button>
                        <span id="submitError" class="admin-submit-error"></span>
                    </div>

                </form>
            </div>
        </div>

        <!-- Right: Info -->
        <div class="admin-panel">
            <div class="admin-panel-header">
                <h2 class="admin-panel-title">
                    <span class="admin-panel-dot"></span>Orderinformation
                </h2>
            </div>

            <div class="admin-panel-body">
                <div class="admin-customer-list">
                    <span class="admin-list-placeholder">
                        Välj en kund och en produkt för att skapa en order.
                    </span>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}