@{
    ViewData["Title"] = "Skapa Order";
    var customers = ViewBag.Customers as IEnumerable<ScrumExtreme.Domain.Entities.User>;
    var hats = ViewBag.Hats as IEnumerable<ScrumExtreme.Domain.Entities.Hats>;
    var items = ViewBag.Items as IEnumerable<ScrumExtreme.Domain.Entities.Item>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />
}

<div class="admin-wrapper">

    @if (TempData["Success"] != null)
    {
        <p class="admin-toast">@TempData["Success"]</p>
    }

    <div class="admin-page-header">
        <h1 class="admin-page-title">Skapa Order</h1>
        <p class="admin-page-subtitle">Skapa en ny order i systemet</p>
    </div>

    <div class="admin-layout">

        <!-- Left: Create order -->
        <div class="admin-panel">
            <div class="admin-panel-header">
                <h2 class="admin-panel-title">
                    <span class="admin-panel-dot"></span>Lägg till ny order
                </h2>

                <a href="/SpecialHats" class="admin-btn-secondary" style="margin-left:auto;">
                    Skapa specialhatt
                </a>
            </div>

            <div class="admin-panel-body">
                <div class="admin-form">

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label for="customerSelect">Kund</label>
                            <select id="customerSelect">
                                <option value="">-- Välj kund --</option>
                                @if (customers != null && customers.Any())
                                {
                                    @foreach (var customer in customers)
                                    {
                                        <option value="@customer.Id">@customer.FirstName @customer.LastName (@customer.Email)
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option disabled>Inga kunder tillgängliga</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label for="hatSelect">Hatt</label>
                            <select id="hatSelect">
                                <option value="">-- Välj hatt --</option>
                                @if (hats != null && hats.Any())
                                {
                                    @foreach (var hat in hats)
                                    {
                                        <option value="@hat.Id" data-name="@hat.Name"
                                                data-price="@hat.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-sizes="@System.Text.Json.JsonSerializer.Serialize(hat.Sizes)"
                                                data-stock="@System.Text.Json.JsonSerializer.Serialize(hat.Stock)">
                                            @hat.Name – @hat.Price kr
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option disabled>Inga hattar tillgängliga</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="admin-field-row --single" id="sizeRow" style="display:none;">
                        <div class="admin-field">
                            <label for="sizeSelect">Tillgängliga storlekar</label>
                            <select id="sizeSelect">
                                <option value="">-- Välj storlek --</option>
                            </select>
                        </div>
                    </div>

                    <div class="admin-field-row --single" id="quantityRow" style="display:none;">
                        <div class="admin-field">
                            <label for="quantityInput">Antal</label>
                            <input type="number" id="quantityInput" min="1" value="1" />
                        </div>
                    </div>

                    <!-- Modifierad hatt -->
                    <div class="admin-field-row --single">
                        <div class="admin-field">
                            <label class="order-toggle-wrap" for="isModifiedInput">
                                <span class="order-toggle-label">Modifiera hatt</span>
                                <div class="order-toggle">
                                    <input type="checkbox" id="isModifiedInput" />
                                    <span class="order-toggle-slider"></span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div id="modifiedHatFields" style="display:none;">
                        <div class="admin-field-row --single">
                            <div class="admin-field">
                                <label for="modificationDescriptionInput">Beskrivning</label>
                                <textarea id="modificationDescriptionInput"
                                          placeholder="T.ex. broderi,text..."></textarea>
                            </div>
                        </div>

                        <div class="admin-field-row --single">
                            <div class="admin-field">
                                <label>Tillbehör</label>
                                <div class="order-items-list" id="itemsList">
                                    <div class="order-items-header">
                                        <span></span>
                                        <span>Namn</span>
                                        <span>Pris/st</span>
                                        <span>Lager</span>
                                    </div>
                                    @if (items != null && items.Any())
                                    {
                                        @foreach (var item in items)
                                        {
                                            bool outOfStock = item.Stock <= 0;
                                            <div class="order-items-row @(outOfStock ? "--out-of-stock" : "")"
                                                 data-item-id="@item.Id"
                                                 data-item-name="@item.Name"
                                                 data-item-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                <label class="order-item-check-label">
                                                    <input type="checkbox" class="order-item-cb" @(outOfStock ? "disabled" : "") />
                                                </label>
                                                <span class="order-item-name">@item.Name</span>
                                                <span class="order-item-price-col">@((int)item.Price) kr</span>
                                                @if (outOfStock)
                                                {
                                                    <span class="order-item-stock --out">Slut på lager</span>
                                                }
                                                else
                                                {
                                                    <span class="order-item-stock">@item.Stock st</span>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="order-items-empty">Inga tillbehör tillgängliga</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="admin-field-row --single">
                            <div class="admin-field">
                                <label for="extraWorkHoursInput">Extra timmar</label>
                                <input type="number" id="extraWorkHoursInput" min="0" step="0.5" value="0" />
                            </div>
                        </div>
                    </div>

                    <div class="admin-submit-area">
                        <button type="button" class="admin-btn-secondary" id="addHatBtn">Lägg till hatt</button>
                        <span id="addHatError" class="order-error"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- Right: Order info -->
        <div class="admin-panel">
            <div class="admin-panel-header">
                <h2 class="admin-panel-title">
                    <span class="admin-panel-dot"></span>Orderinformation
                </h2>
            </div>

            <div class="admin-panel-body">

                <div id="customerInfoBlock">
                    <span class="admin-list-placeholder">Välj en kund för att se information.</span>
                </div>

                <div id="hatListBlock" style="display:none; margin-top: 1rem;">
                    <p class="info-label"
                           style="font-size:0.72rem;color:#666;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">
                        Valda hattar</p>
                        <ul class="order-hat-list" id="hatList"></ul>
                        <div class="order-total">
                            <span>Totalt</span>
                            <span class="order-total-amount" id="totalAmount">0 kr</span>
                        </div>
                    </div>

                    <div class="order-panel-actions">
                        <button type="button" class="admin-btn-primary" id="createOrderBtn" style="display:none;">Skapa
                            order</button>
                            <span id="createOrderError" class="order-error"></span>
                        </div>

                    </div>
                </div>

            </div>

        </div>

        @section Scripts {
            <script>
                const customerSelect = document.getElementById('customerSelect');
                const hatSelect = document.getElementById('hatSelect');
                const sizeSelect = document.getElementById('sizeSelect');
                const sizeRow = document.getElementById('sizeRow');
                const quantityInput = document.getElementById('quantityInput');
                const quantityRow = document.getElementById('quantityRow');
                const addHatBtn = document.getElementById('addHatBtn');
                const addHatError = document.getElementById('addHatError');
                const customerInfoBlock = document.getElementById('customerInfoBlock');
                const hatListBlock = document.getElementById('hatListBlock');
                const hatList = document.getElementById('hatList');
                const totalAmountEl = document.getElementById('totalAmount');
                const createOrderBtn = document.getElementById('createOrderBtn');
                const createOrderError = document.getElementById('createOrderError');
                const isModifiedInput = document.getElementById('isModifiedInput');
                const modificationDescriptionInput = document.getElementById('modificationDescriptionInput');
                const extraWorkHoursInput = document.getElementById('extraWorkHoursInput');
                const modifiedHatFields = document.getElementById('modifiedHatFields');

                let cart = []; // { hatId, name, unitPrice, hatBasePrice, itemCost, size, quantity, maxStock, isModified, modificationDescription, itemIds, extraWorkHours }

                // --- Hat select: populate sizes with stock ---
                hatSelect.addEventListener('change', () => {
                    addHatError.textContent = '';
                    sizeSelect.innerHTML = '<option value="">-- Välj storlek --</option>';
                    quantityInput.value = 1;
                    quantityRow.style.display = 'none';
                    clearQtyState();
                    const opt = hatSelect.options[hatSelect.selectedIndex];
                    if (opt && opt.value) {
                        const sizes = JSON.parse(opt.dataset.sizes || '[]');
                        const stock = JSON.parse(opt.dataset.stock || '{}');
                        // Only show sizes that actually have stock
                        const inStock = sizes.filter(s => (stock[s] || 0) > 0);
                        if (inStock.length > 0) {
                            inStock.forEach(s => {
                                const o = document.createElement('option');
                                o.value = s;
                                o.textContent = `${s} (${stock[s]} i lager)`;
                                o.dataset.max = stock[s];
                                sizeSelect.appendChild(o);
                            });
                            sizeRow.style.display = '';
                        } else {
                            sizeRow.style.display = '';
                            const o = document.createElement('option');
                            o.disabled = true;
                            o.textContent = 'Slutsålt i alla storlekar';
                            sizeSelect.appendChild(o);
                        }
                    } else {
                        sizeRow.style.display = 'none';
                    }
                });

                // --- Size select: update quantity max ---
                sizeSelect.addEventListener('change', () => {
                    addHatError.textContent = '';
                    const opt = sizeSelect.options[sizeSelect.selectedIndex];
                    if (opt && opt.value && opt.dataset.max) {
                        quantityInput.max = opt.dataset.max;
                        quantityInput.value = 1;
                        quantityRow.style.display = '';
                        validateQty();
                    } else {
                        quantityRow.style.display = 'none';
                        clearQtyState();
                    }
                });

                // --- Live qty validation ---
                function validateQty() {
                    const qty = parseInt(quantityInput.value, 10);
                    const max = parseInt(quantityInput.max, 10);
                    const valid = !isNaN(qty) && qty >= 1 && (!quantityInput.max || qty <= max);
                    quantityInput.classList.toggle('--valid', valid);
                    quantityInput.classList.toggle('--invalid', !valid);
                    addHatBtn.classList.toggle('--valid', valid);
                    addHatBtn.classList.toggle('--invalid', !valid);
                }

                function clearQtyState() {
                    quantityInput.classList.remove('--valid', '--invalid');
                    addHatBtn.classList.remove('--valid', '--invalid');
                }

                quantityInput.addEventListener('input', validateQty);

                        // --- Show/hide modified hat fields ---
                function toggleModifiedHatFields() {
                    modifiedHatFields.style.display = isModifiedInput.checked ? 'block' : 'none';
                }

                isModifiedInput.addEventListener('change', toggleModifiedHatFields);

                    // Kör direkt när sidan laddas
                toggleModifiedHatFields();

                // --- Customer select ---
                customerSelect.addEventListener('change', async () => {
                    const id = customerSelect.value;
                    if (!id) {
                        customerInfoBlock.innerHTML = '<span class="admin-list-placeholder">Välj en kund för att se information.</span>';
                        updateCreateBtn();
                        return;
                    }
                    try {
                        const resp = await fetch(`/Orders/CustomerInfo/${encodeURIComponent(id)}`);
                        if (!resp.ok) throw new Error();
                        const c = await resp.json();
                        customerInfoBlock.innerHTML = `
                                                                <div class="order-customer-info">
                                                                    <p class="info-label">Kund</p>
                                                                    <p><strong>${esc(c.fullName)}</strong></p>
                                                                    <p>${esc(c.email)}</p>
                                                                    <p class="info-label">Leveransadress</p>
                                                                    <p>${esc(c.address)}</p>
                                                                    <p>${esc(c.postalCode)} ${esc(c.city)}</p>
                                                                    <p>${esc(c.country)} (${esc(c.countryCode)})</p>
                                                                    <p class="info-label">Telefon</p>
                                                                    <p>${esc(c.phone)}</p>
                                                                </div>`;
                    } catch {
                        customerInfoBlock.innerHTML = '<span class="admin-list-placeholder" style="color:#ff453a;">Kunde inte hämta kundinformation.</span>';
                    }
                    updateCreateBtn();
                });

                // --- Get selected items from checkbox table ---
                function getSelectedItems() {
                    if (!isModifiedInput.checked) return [];
                    const rows = document.querySelectorAll('#itemsList .order-items-row:not(.--out-of-stock)');
                    const selected = [];
                    rows.forEach(row => {
                        const cb = row.querySelector('.order-item-cb');
                        if (cb && cb.checked) {
                            selected.push({
                                id: row.dataset.itemId,
                                name: row.dataset.itemName,
                                price: parseFloat(row.dataset.itemPrice) || 0
                            });
                        }
                    });
                    return selected;
                }

                // --- Add hat ---
                addHatBtn.addEventListener('click', () => {
                    addHatError.textContent = '';
                    const opt = hatSelect.options[hatSelect.selectedIndex];
                    if (!opt || !opt.value) {
                        addHatError.textContent = 'Välj en hatt först.';
                        return;
                    }
                    const size = sizeSelect.value;
                    if (!size) {
                        addHatError.textContent = 'Välj en storlek först.';
                        return;
                    }
                    const sizeOpt = sizeSelect.options[sizeSelect.selectedIndex];
                    const maxStock = parseInt(sizeOpt.dataset.max || '0', 10);
                    const qty = parseInt(quantityInput.value, 10);
                    if (isNaN(qty) || qty < 1) {
                        addHatError.textContent = 'Ange ett giltigt antal (minst 1).';
                        return;
                    }
                    if (qty > maxStock) {
                        addHatError.textContent = `Max ${maxStock} i lager för den storleken.`;
                        return;
                    }
                    const hatId = opt.value;
                    if (cart.some(h => h.hatId === hatId && h.size === size)) {
                        addHatError.textContent = 'Den hatten i den storleken är redan tillagd.';
                        return;
                    }
        // Hämta valda tillbehör och beräkna kostnad
                    const selectedItems = getSelectedItems();
                    const itemCost = selectedItems.reduce((sum, i) => sum + i.price, 0);
                    const hatBasePrice = parseFloat(opt.dataset.price);
                    const extraHours = parseFloat(extraWorkHoursInput.value || '0');
                    const hoursCost = extraHours * 200;

                    cart.push({
                        hatId,
                        name: opt.dataset.name,
                        size,
                        quantity: qty,
                        maxStock,
                        unitPrice: hatBasePrice + itemCost + hoursCost,
                        hatBasePrice,
                        itemCost,
                        items: selectedItems, // full objects: { id, name, price }
                        isModified: isModifiedInput.checked,
                        modificationDescription: modificationDescriptionInput.value.trim(),
                        itemIds: selectedItems.map(i => i.id),
                        extraWorkHours: extraHours,
                        hoursCost
                    });

                    // Nollställ modifieringsfält
                    isModifiedInput.checked = false;
                    toggleModifiedHatFields();
                    modificationDescriptionInput.value = '';
                    extraWorkHoursInput.value = '0';
                    document.querySelectorAll('#itemsList .order-item-cb').forEach(cb => cb.checked = false);

                    renderCart();
                    updateCreateBtn();
                });

                function renderCart() {
                    hatList.innerHTML = '';
                    if (cart.length === 0) {
                        hatListBlock.style.display = 'none';
                        return;
                    }
                    hatListBlock.style.display = 'block';
                    let total = 0;
                    cart.forEach(h => {
                        const lineTotal = h.unitPrice * h.quantity;
                        total += lineTotal;

                        const li = document.createElement('li');
                        li.className = 'order-hat-item --expanded';

                        // Header row: hat name + remove button
                        let html = `
                            <div class="order-hat-row order-hat-header">
                                <span class="order-hat-title">${esc(h.name)} <span class="order-hat-size">(${esc(h.size)}) × ${h.quantity}</span></span>
                                <button class="order-hat-remove" data-id="${esc(h.hatId)}" data-size="${esc(h.size)}" title="Ta bort">✕</button>
                            </div>
                            <div class="order-hat-row order-hat-sub">
                                <span>Hatt</span>
                                <span class="order-hat-item-price">${Math.round(h.hatBasePrice)} kr</span>
                            </div>`;

                        // Each accessory
                        (h.items || []).forEach(acc => {
                            html += `
                            <div class="order-hat-row order-hat-sub">
                                <span>${esc(acc.name)}</span>
                                <span class="order-hat-item-price">${Math.round(acc.price)} kr</span>
                            </div>`;
                        });

                        // Work hours
                        if (h.extraWorkHours > 0) {
                            html += `
                            <div class="order-hat-row order-hat-sub">
                                <span>Extra timmar (${h.extraWorkHours}h × 200 kr)</span>
                                <span class="order-hat-item-price">${Math.round(h.hoursCost)} kr</span>
                            </div>`;
                        }

                        // Total line for this hat
                        html += `
                            <div class="order-hat-row order-hat-total-row">
                                <span>Totalt</span>
                                <span class="order-hat-item-price">${Math.round(lineTotal)} kr</span>
                            </div>`;

                        li.innerHTML = html;
                        hatList.appendChild(li);
                    });
                    totalAmountEl.textContent = Math.round(total) + ' kr';
                    hatList.querySelectorAll('.order-hat-remove').forEach(btn => {
                        btn.addEventListener('click', () => {
                            cart = cart.filter(h => !(h.hatId === btn.dataset.id && h.size === btn.dataset.size));
                            renderCart();
                            updateCreateBtn();
                        });
                    });
                }

                function updateCreateBtn() {
                    const hasCustomer = !!customerSelect.value;
                    const hasHats = cart.length > 0;
                    createOrderBtn.style.display = (hasCustomer && hasHats) ? '' : 'none';
                }

                // ---  Create order ---
                createOrderBtn.addEventListener('click', async () => {
                    createOrderError.textContent = '';
                    createOrderBtn.disabled = true;
                    createOrderBtn.textContent = 'Sparar…';
                    try {
                        const payload = {
                            customerId: customerSelect.value,
                            items: cart.map(h => ({ hatId: h.hatId, name: h.name, size: h.size, quantity: h.quantity, unitPrice: h.unitPrice,
                             isModified: h.isModified, modificationDescription: h.modificationDescription, itemIds: h.itemIds,
                             addedMaterialCost: 0, extraWorkHours: h.extraWorkHours
                            }))
                        };
                        const resp = await fetch('/Orders/Create', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        if (!resp.ok) {
                            const err = await resp.json().catch(() => ({}));
                            throw new Error(err.error || 'Något gick fel.');
                        }
                        window.location.href = '/Orders';
                    } catch (e) {
                        createOrderError.textContent = e.message;
                        createOrderBtn.disabled = false;
                        createOrderBtn.textContent = 'Skapa order';
                    }
                });

                function esc(str) {
                    if (!str) return '';
                    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                }
            </script>
        }
