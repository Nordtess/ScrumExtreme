@model IEnumerable<ScrumExtreme.Domain.Entities.Order>

@{
    ViewData["Title"] = "Ordrar";
    var emailLookup = ViewBag.EmailLookup as Dictionary<string, string> ?? new Dictionary<string, string>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />
}

<div class="admin-wrapper">

    @if (TempData["Success"] != null)
    {
        <p class="admin-toast">@TempData["Success"]</p>
    }

    <div class="admin-page-header">
        <h1 class="admin-page-title">Ordrar</h1>
        <p class="admin-page-subtitle">Alla ordrar i systemet</p>
    </div>

    <div class="admin-panel">
        <div class="admin-panel-header">
            <h2 class="admin-panel-title">
                <span class="admin-panel-dot"></span>Orderhistorik
                @if (Model != null)
                {
                    <span class="admin-customer-count">@Model.Count()</span>
                }
            </h2>
            <a asp-action="Create" class="admin-panel-btn">Skapa ny order →</a>
        </div>
        <div class="admin-panel-body">
            <div class="admin-customer-list">
                @if (Model == null || !Model.Any())
                {
                    <span class="admin-list-placeholder">Inga ordrar hittades.</span>
                }
                else
                {
                    foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                    {
                        <div class="admin-customer-row">
                            <span class="admin-customer-name">@order.OrderNumber
                                @if (order.Items != null && order.Items.Any(i => i.IsModified))
                                {
                                    <span style="color:#c9a84c; font-size:0.8rem;">(Modifierad)</span>
                                }
                            </span>
                            <span style="color:#888;font-size:0.82rem;">@(emailLookup.TryGetValue(order.UserId, out var email) ?
                                                        email : "–")</span>
                                <span class="admin-customer-country">@order.Status</span>
                                <span style="color:#666;font-size:0.8rem;">@order.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                <span style="color:#c9a84c;font-size:0.85rem;font-weight:600;">@order.TotalAmount.ToString("0.00")
                                    kr</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

        </div>
