@model IEnumerable<ScrumExtreme.Domain.Entities.Order>

@using ScrumExtreme.Domain.Entities
@{
    ViewData["Title"] = "Ordrar";
    var userLookup = ViewBag.UserLookup as Dictionary<string, ScrumExtreme.Domain.Entities.User>
                     ?? new Dictionary<string, ScrumExtreme.Domain.Entities.User>();
    var availableYears = (Model ?? Enumerable.Empty<Order>())
        .Select(o => o.OrderDate.Year)
        .Distinct()
        .OrderByDescending(y => y)
        .ToList();
    if (!availableYears.Any()) availableYears = new List<int> { DateTime.Now.Year };
}

@section Styles {
    <link rel="stylesheet" href="~/css/addcustomer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />
}

<div class="admin-wrapper">

    @if (TempData["Success"] != null)
    {
        <p class="admin-toast">@TempData["Success"]</p>
    }

    <div class="admin-page-header">
        <h1 class="admin-page-title">Ordrar</h1>
        <p class="admin-page-subtitle">Alla ordrar i systemet</p>
    </div>

    
    <div class="order-filter-bar">
        <div class="order-filter-group">
            <label class="order-filter-label" for="orderSortFilter">Sortera</label>
            <select id="orderSortFilter" class="order-filter-select">
                <option value="newest" selected>Senast skapad</option>
                <option value="oldest">Tidigast skapad</option>
            </select>
        </div>
        <div class="order-filter-group">
            <span class="order-filter-label">Typ</span>
            <div class="order-type-pills">
                <button class="order-type-pill active" data-type="standard">Standard</button>
                <button class="order-type-pill active" data-type="modifierad">Modifierad</button>
                <button class="order-type-pill active" data-type="special">Special</button>
            </div>
        </div>
        <div class="order-filter-group">
            <label class="order-filter-label" for="orderStatusFilter">Status</label>
            <select id="orderStatusFilter" class="order-filter-select">
                <option value="all" selected>Visa alla</option>
                <option value="pending">Väntar</option>
                <option value="processing">Påbörjad</option>
                <option value="printed">Utskriven</option>
                <option value="shipped">Skickad</option>
            </select>
        </div>
        <div class="order-filter-group">
            <label class="order-filter-label" for="orderYearFilter">Årtal</label>
            <select id="orderYearFilter" class="order-filter-select">
                @foreach (var yr in availableYears)
                {
                    if (yr == DateTime.Now.Year)
                    {
                        <option value="@yr" selected>@yr</option>
                    }
                    else
                    {
                        <option value="@yr">@yr</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="admin-panel">
        <div class="admin-panel-header">
            <h2 class="admin-panel-title">
                <span class="admin-panel-dot"></span>Orderhistorik
                @if (Model != null)
                {
                    <span class="admin-customer-count">@Model.Count()</span>
                }
            </h2>
            <a asp-action="Create" class="admin-panel-btn">Skapa ny order →</a>
        </div>
        <div class="admin-panel-body">
            <div class="admin-customer-list orders-list-scroll">
                @if (Model == null || !Model.Any())
                {
                    <span class="admin-list-placeholder">Inga ordrar hittades.</span>
                }
                else
                {
                    foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                    {
                        string orderTypClass;
                        string orderTypLabel;
                        if (order.Items != null && order.Items.Any(i => i.SpecialHats != null))
                        {
                            orderTypClass = "order-type-badge order-type-special";
                            orderTypLabel = "Special";
                        }
                        else if (order.Items != null && order.Items.Any(i => i.IsModified))
                        {
                            orderTypClass = "order-type-badge order-type-modified";
                            orderTypLabel = "Modifierad";
                        }
                        else
                        {
                            orderTypClass = "order-type-badge order-type-standard";
                            orderTypLabel = "Standard";
                        }
                        var hasUser = userLookup.TryGetValue(order.UserId, out var u);
                        string firstName = hasUser ? u!.FirstName : "–";
                        string lastName = hasUser ? u!.LastName : "";
                        string email = hasUser ? u!.Email : "–";
                        string country = hasUser ? u!.Country : "–";
                        string countryCode = hasUser ? u!.CountryCode : "";
                        string flagEmoji = string.IsNullOrEmpty(countryCode) ? "" :
                            string.Concat(countryCode.ToUpper().Select(ch => char.ConvertFromUtf32(0x1F1A5 + (int)ch)));
                        var hatParts = (order.Items ?? new List<OrderItem>())
                            .Select(i =>
                            {
                                var label = i.SpecialHats != null ? (i.SpecialHats.Name ?? "Special") : i.Name;
                                var sizeStr = string.IsNullOrEmpty(i.Size) ? "" : $" {i.Size}";
                                return i.Quantity > 1 ? $"{label}{sizeStr} ×{i.Quantity}" : $"{label}{sizeStr}";
                            });
                        string hatSummary = string.Join(", ", hatParts);
                        string statusKey = order.Status.ToString().ToLower();
                        string statusLabel = order.Status switch
                        {
                            OrderStatus.Pending => "Väntar",
                            OrderStatus.Processing => "Påbörjad",
                            OrderStatus.Printed => "Utskriven",
                            OrderStatus.Shipped => "Skickad",
                            _ => order.Status.ToString()
                        };
                        string typeKey = orderTypLabel.ToLower();
                        string? workerName = null;
                        if (!string.IsNullOrEmpty(order.AssignedWorkerId)
                            && order.Status is ScrumExtreme.Domain.Entities.OrderStatus.Processing or
                ScrumExtreme.Domain.Entities.OrderStatus.Printed
                            && userLookup.TryGetValue(order.AssignedWorkerId, out var worker))
                        {
                            workerName = worker.FirstName;
                        }
                        <div class="admin-customer-row" data-date="@order.OrderDate.ToUniversalTime().Ticks"
                             data-type="@typeKey" data-status="@statusKey" data-year="@order.OrderDate.Year">
                            <a asp-action="Details" asp-route-id="@order.Id" class="admin-customer-name">
                                @order.OrderNumber
                            </a>
                            <span class="@orderTypClass">@orderTypLabel</span>
                            <div class="order-col-person">
                                <span class="order-col-name">@firstName @lastName</span>
                                <span class="order-col-email">@email</span>
                            </div>
                            <span class="order-col-hats" title="@hatSummary">@hatSummary</span>
                            <span class="order-col-country">@flagEmoji @country</span>
                            <span class="order-status-badge order-status-@statusKey">@statusLabel</span>
                            <span
                                class="order-worker-badge @(string.IsNullOrEmpty(workerName) ? "order-worker-badge--empty" : "")"
                                title="@(!string.IsNullOrEmpty(workerName) ? "Hanteras av " + workerName : "")">@(workerName ??
                                               "")</span>
                                <span class="order-col-date">@order.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                <span class="order-col-amount">@order.TotalAmount.ToString("0.00") kr</span>
                                <button class="order-delete-btn" data-id="@order.Id" title="Ta bort order">✕</button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>

    @section Scripts {
        <script>
            const sortSelect = document.getElementById('orderSortFilter');
            const statusSelect = document.getElementById('orderStatusFilter');
            const yearSelect = document.getElementById('orderYearFilter');
            const list = document.querySelector('.admin-customer-list');

            document.querySelectorAll('.order-type-pill').forEach(pill => {
                pill.addEventListener('click', function () {
                    this.classList.toggle('active');
                    applyFilters();
                });
            });

            function applyFilters() {
                const rows = Array.from(list.querySelectorAll('.admin-customer-row'));
                const activePills = new Set(
                    Array.from(document.querySelectorAll('.order-type-pill.active')).map(p => p.dataset.type)
                );
                const statusVal = statusSelect.value;
                const yearVal = yearSelect.value;
                const newest = sortSelect.value === 'newest';

                rows.sort((a, b) => {
                    const da = BigInt(a.dataset.date);
                    const db = BigInt(b.dataset.date);
                    return newest ? (db > da ? 1 : db < da ? -1 : 0)
                        : (da > db ? 1 : da < db ? -1 : 0);
                });
                rows.forEach(r => list.appendChild(r));

                let visible = 0;
                rows.forEach(row => {
                    const typeMatch = activePills.has(row.dataset.type);
                    const statusMatch = statusVal === 'all' || row.dataset.status === statusVal;
                    const yearMatch = row.dataset.year === yearVal;
                    const show = typeMatch && statusMatch && yearMatch;
                    row.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                const countEl = document.querySelector('.admin-customer-count');
                if (countEl) countEl.textContent = visible;
            }

            sortSelect.addEventListener('change', applyFilters);
            statusSelect.addEventListener('change', applyFilters);
            yearSelect.addEventListener('change', applyFilters);
            applyFilters();

            document.querySelectorAll('.order-delete-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const id = this.dataset.id;
                    if (!confirm('Är du säker på att du vill ta bort denna order?')) return;
                    const res = await fetch(`/Orders/Delete/${id}`, { method: 'POST' });
                    if (res.ok) {
                        this.closest('.admin-customer-row').remove();
                        const countEl = document.querySelector('.admin-customer-count');
                        if (countEl) countEl.textContent = parseInt(countEl.textContent) - 1;
                    } else {
                        alert('Något gick fel. Försök igen.');
                    }
                });
            });
        </script>
    }
