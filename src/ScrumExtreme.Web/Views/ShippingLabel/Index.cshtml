@model ScrumExtreme.Web.Models.ShippingLabelViewModel

@{
    ViewData["Title"] = Model.HasOrder ? "Fraktsedel – " + Model.OrderNumber : "Fraktsedel";

    // Build barcode reference from real data or placeholder
    var barcodeRef = Model.HasOrder
        ? $"{Model.CountryCode}-{Model.PostalCode}-{string.Concat(Model.FullName.Split(' ').Select(p => p.Length > 0 ?
p[0].ToString().ToUpper() : ""))}-{DateTime.UtcNow.Year}"
        : "SE-71231-MK-2026";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shippinglabel.css" asp-append-version="true" />
}

<div class="sl-page">

    <!-- Language picker (hidden when printing) -->
    <div class="sl-picker-wrap">
        <label class="sl-picker-label" for="slCountrySearch">Välj land för att testa etikettspråk</label>
        <div class="country-picker">
            <input type="text" id="slCountrySearch" placeholder="Sök land, t.ex. Sverige…" autocomplete="off" />
            <ul id="slCountryDropdown" class="country-dropdown country-dropdown--hidden"></ul>
        </div>
        <p class="sl-lang-hint">Etiketter visas nu på: <strong id="slLangDisplay">Svenska</strong></p>
    </div>

    <!-- Shipping label card -->
    <div class="sl-card">
        <div class="sl-card-header">
            <span class="sl-card-logo">Hattmakaren AB</span>
            <span class="sl-card-type" id="lbl-type">Fraktsedel</span>
        </div>

        <div class="sl-divider"></div>

        <div class="sl-section-title" id="lbl-recipient-title">MOTTAGARE</div>

        <div class="sl-row">
            <span class="sl-label" id="lbl-name">Namn</span>
            <span class="sl-value" id="val-name">@(Model.HasOrder? Model.FullName: "Malik King")</span>
        </div>
        <div class="sl-row">
            <span class="sl-label" id="lbl-address">Adress</span>
            <span class="sl-value" id="val-address">@(Model.HasOrder? Model.Address: "Piratestreet 24")</span>
        </div>
        <div class="sl-row">
            <span class="sl-label" id="lbl-postalCode">Postnummer</span>
            <span class="sl-value" id="val-postalCode">@(Model.HasOrder? Model.PostalCode: "71231")</span>
        </div>
        <div class="sl-row">
            <span class="sl-label" id="lbl-city">Stad</span>
            <span class="sl-value" id="val-city">@(Model.HasOrder? Model.City: "Mogadishu")</span>
        </div>
        <div class="sl-row">
            <span class="sl-label" id="lbl-country">Land</span>
            <span class="sl-value" id="val-country">@(Model.HasOrder? Model.Country: "Somalia")</span>
        </div>
        <div class="sl-row">
            <span class="sl-label" id="lbl-phone">Telefon</span>
            <span class="sl-value" id="val-phone">@(Model.HasOrder? Model.Phone: "+46 712 312 100")</span>
        </div>

        <div class="sl-divider"></div>

        <div class="sl-barcode-spacer"></div>

        <div class="sl-divider"></div>

        <div class="sl-barcode">||||| |||| ||||| |||| |||||</div>
        <div class="sl-barcode-num">@barcodeRef</div>
    </div>

    <!-- Print button (hidden when printing) -->
    <button class="sl-print-btn" id="printBtn">Skriv ut fraktsedel</button>

</div>

@section Scripts {
    <script>
        // Pass server-side country code to JS for auto language selection
        window.slCountryCode = "@Model.CountryCode";
    </script>
    <script src="~/js/shippinglabel.js" asp-append-version="true"></script>
}
