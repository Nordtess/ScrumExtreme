@model ScrumExtreme.Web.Models.CreateCustomerViewModel
@{
    ViewData["Title"] = "Admin Test";
    var customers = ViewBag.Customers as IEnumerable<ScrumExtreme.Domain.Entities.User>;
}

<div class="admin-wrapper">

    @if (TempData["Success"] != null)
    {
        <p class="admin-toast">@TempData["Success"]</p>
    }

    <!-- Alla kunder -->
    <div class="admin-card">
        <div class="admin-card-header">
            <h2 class="admin-card-title">Alla kunder</h2>
            <form asp-action="HamtaAllaKunder" method="post">
                <button type="submit" class="admin-btn-outline">Hämta alla kunder</button>
            </form>
        </div>

        <div class="admin-customer-list">
            @if (customers == null)
            {
                <span class="admin-list-placeholder">Tryck på "Hämta alla kunder" för att visa listan.</span>
            }
            else
            {
                var list = customers.ToList();
                if (list.Count == 0)
                {
                    <span class="admin-list-placeholder">Inga kunder hittades.</span>
                }
                else
                {
                    foreach (var c in list)
                    {
                        <div class="admin-customer-row">
                            <span class="admin-customer-name">@c.FirstName @c.LastName</span>
                            <span class="admin-customer-country">@c.Country</span>
                        </div>
                    }
                }
            }
        </div>
    </div>

    <!-- Lägg till ny kund -->
    <div class="admin-card">
        <h2 class="admin-card-title">Lägg till ny kund</h2>

        <form asp-action="SkapaKund" method="post" class="admin-form" id="createCustomerForm">
            <div class="admin-field">
                <label asp-for="FirstName">Förnamn</label>
                <input asp-for="FirstName" placeholder="Förnamn" autocomplete="given-name" />
                <span id="error-FirstName" class="admin-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="LastName">Efternamn</label>
                <input asp-for="LastName" placeholder="Efternamn" autocomplete="family-name" />
                <span id="error-LastName" class="admin-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="Email">E-post</label>
                <input asp-for="Email" placeholder="T.ex. namn@exempel.se" autocomplete="email" type="email" />
                <span id="error-Email" class="admin-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="Address">Adress</label>
                <input asp-for="Address" placeholder="T.ex. Strandvägen 13" autocomplete="street-address" />
                <span id="error-Address" class="admin-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="City">Stad</label>
                <input asp-for="City" placeholder="Stad" autocomplete="address-level2" />
                <span id="error-City" class="admin-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="PostalCode">Postnummer</label>
                <input asp-for="PostalCode" placeholder="T.ex. 70362" autocomplete="postal-code" />
                <span id="error-PostalCode" class="admin-error"></span>
            </div>
            <div class="admin-field">
                <label for="countrySearch">Land</label>
                <div class="country-picker">
                    <input type="text" id="countrySearch" placeholder="Sök land, t.ex. Sverige…" autocomplete="off" />
                    <ul id="countryDropdown" class="country-dropdown country-dropdown--hidden"></ul>
                </div>
                <input type="hidden" id="countryHidden" name="Country" />
                <input type="hidden" id="countryCodeHidden" name="CountryCode" />
                <span id="error-Country" class="admin-error"></span>
            </div>
            <div class="admin-field">
                <label asp-for="PhoneNumber">Telefonnummer</label>
                <input asp-for="PhoneNumber" placeholder="Välj ett land ovan, sedan siffror" autocomplete="tel" />
                <span id="error-PhoneNumber" class="admin-error"></span>
            </div>
            <div class="admin-submit-area">
                <button type="submit" class="admin-btn-primary" id="submitBtn">Skapa</button>
                <span id="submitError" class="admin-submit-error"></span>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
